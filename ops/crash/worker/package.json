{
  "name": "wavee-crash-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker ingest + query service for Wavee's opt-in crash reports (R2 + D1). Deployed by hand, no CI.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "dev": "npm --prefix ../dashboard run build && wrangler dev --local",
    "deploy": "npm --prefix ../dashboard run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "better-sqlite3": "^11.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
