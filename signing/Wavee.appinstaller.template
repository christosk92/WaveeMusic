<?xml version="1.0" encoding="utf-8"?>
<!--
  WaveeMusic .appinstaller manifest. The build pipeline substitutes ${VERSION}
  with the tag's semver (e.g. 0.1.0.0) and uploads this file to the GitHub
  Release. Users one-click install Wavee.appinstaller; Windows then auto-pulls
  subsequent updates from the same URL every 24h on launch.

  Both architectures (x64 + ARM64) are listed under MainPackage so the App
  Installer picks the matching one for the user's hardware.
-->
<AppInstaller Version="${VERSION}"
              Uri="https://github.com/christosk92/WaveeMusic/releases/latest/download/Wavee.appinstaller"
              xmlns="http://schemas.microsoft.com/appx/appinstaller/2018">

  <MainPackage Name="4f5ca249-aa41-4d46-84ce-62b6098fdb06"
               Version="${VERSION}"
               Publisher="CN=cproducts, O=cproducts, L=Utrecht, S=Utrecht, C=NL"
               Uri="https://github.com/christosk92/WaveeMusic/releases/download/v${TAG}/Wavee.UI.WinUI_${VERSION}_x64.msix"
               ProcessorArchitecture="x64" />

  <UpdateSettings>
    <OnLaunch HoursBetweenUpdateChecks="24" ShowPrompt="false" />
    <AutomaticBackgroundTask />
  </UpdateSettings>

</AppInstaller>
