<Project>

  <!--
    Single source of truth for the .NET framework version across every
    first-party + vendored project in the build graph.

    To move the whole repo to another .NET version (upgrade OR downgrade),
    change WaveeNetVersion below and update the SDK pin in global.json to
    match. Nothing else needs editing — every project's <TargetFramework>
    derives from the properties here:

        net11.0  <->  net10.0   =   flip WaveeNetVersion + global.json

    This file only DEFINES properties; it sets no <TargetFramework> itself,
    so projects that don't opt in (the vendored NVorbis TestApp on net45,
    .unicorn-build, scratch projects) are completely unaffected — they just
    receive a couple of unused MSBuild properties.
  -->
  <PropertyGroup>
    <WaveeNetVersion>11.0</WaveeNetVersion>
    <WaveeWindowsSdk>10.0.26100.0</WaveeWindowsSdk>
    <WaveeDotNetTfm>net$(WaveeNetVersion)</WaveeDotNetTfm>
    <WaveeWindowsTfm>net$(WaveeNetVersion)-windows$(WaveeWindowsSdk)</WaveeWindowsTfm>
  </PropertyGroup>

</Project>
