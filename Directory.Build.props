<Project>

  <!-- Wavee repo baseline (root Directory.Build.props: every project under src/apps, modules and vendor inherits it).
       Mirrors the engine's src/Directory.Build.props PropertyGroup so the Wavee projects share the engine's
       net10 / zero-alloc / GC posture; the engine itself lives in the sibling checkout named by $(EngineRoot) below.
       `PublishAot` is set ONLY on the WinExe csproj (avoids NETSDK1207 on the class lib). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>

    <Deterministic>true</Deterministic>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>

    <!-- Warning-clean is enforced (mirrors src/Directory.Build.props) for every project under src/apps, Wavee.Tests
         included; a project opts out only in its own csproj, and none in the solution does. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The engine projects are referenced from outside the solution (see Wavee.slnx). In a SOLUTION build MSBuild unsets
         Configuration/Platform for such references (ShouldUnsetParentConfigurationAndPlatform), so `dotnet build
         Wavee.slnx -c Release` built the engine as Debug and copied bin\Debug\FluentGpu.*.dll into this app's bin\Release:
         the DEBUG parity self-check then ran every frame (2026-09-17). Keep the parent configuration on every reference. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!-- Debug skips the trim/AOT/single-file Roslyn analyzers that PublishAot=true switches on: ILLink's
       DynamicallyAccessedMembersAnalyzer was 96% of analyzer time and roughly halved an edit-build (24 s -> 13 s for one
       changed file in Wavee, 2026-10-06). Release keeps them, and the AOT publish's ILC checks everything again.
       Mirrors the engine's src/Directory.Build.props. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- FLUENTGPU_DIAG: mirrors src/Directory.Build.props (which this file does NOT inherit — see the header above).
       [Conditional] erasure is decided by the CALLING assembly, so without this the app's ScrollTrace.Note / OffsetWrite
       call sites stay erased even when the engine is compiled with the symbol. See ops/diag/README.md. -->
  <PropertyGroup Condition="'$(FluentGpuDiag)' == 'true'">
    <DefineConstants>$(DefineConstants);FLUENTGPU_DIAG</DefineConstants>
  </PropertyGroup>

  <!-- The FluentGpu engine is a SIBLING checkout, never a package: C:\wavee\fluent-gpu next to C:\wavee\WaveeMusic.
       Every engine ProjectReference in this repo goes through $(EngineRoot) so there is exactly one place to change,
       and a missing checkout fails the build with a sentence instead of forty NU1105s. -->
  <!-- A checkout may pin its engine in a git-ignored EngineRoot.local.props (a worktree built against a pinned engine
       worktree, decision D1); a command-line -p:EngineRoot still wins over both. -->
  <Import Project="$(MSBuildThisFileDirectory)EngineRoot.local.props" Condition="'$(EngineRoot)' == '' and Exists('$(MSBuildThisFileDirectory)EngineRoot.local.props')" />
  <PropertyGroup>
    <EngineRoot Condition="'$(EngineRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\fluent-gpu'))</EngineRoot>
  </PropertyGroup>
  <Target Name="WaveeRequireEngineCheckout" BeforeTargets="BeforeBuild;Restore;CollectPackageReferences"
          Condition="!Exists('$(EngineRoot)src\FluentGpu.Engine\FluentGpu.Engine.csproj')">
    <Error Text="FluentGpu engine checkout not found at '$(EngineRoot)'. Clone https://github.com/christosk92/fluent-gpu next to this repository (C:\wavee\fluent-gpu beside C:\wavee\WaveeMusic) or set EngineRoot." />
  </Target>

  <!-- Tests are banned (owner decision 2026-10-20): no unit/integration test projects, no VerticalSlice-style harnesses.
       Verification is the app's headless inspector (Wavee.exe in inspect mode: renders, traces, crossings, lint) and screenshots.
       This target fails any project that tries to become a test project again. -->
  <Target Name="BanTestProjects" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_BannedTestPackage Include="@(PackageReference)"
                          Condition="'%(Identity)' == 'Microsoft.NET.Test.Sdk' Or $([System.String]::Copy('%(Identity)').StartsWith('xunit')) Or $([System.String]::Copy('%(Identity)').StartsWith('NUnit')) Or $([System.String]::Copy('%(Identity)').StartsWith('MSTest')) Or '%(Identity)' == 'coverlet.collector'" />
    </ItemGroup>
    <Error Condition="'$(IsTestProject)' == 'true' Or '@(_BannedTestPackage)' != ''"
           Text="$(MSBuildProjectName) is a test project ('@(_BannedTestPackage)'). Tests are banned in this repo: verify with the headless inspector (Wavee.exe --inspect) and screenshots instead." />
  </Target>

</Project>
