<Solution>
  <!-- The Wavee app solution. The engine is a SIBLING checkout resolved by $(EngineRoot) in Directory.Build.props
       (a command-line override, then a worktree's git-ignored EngineRoot.local.props pin, then the sibling
       ..\fluent-gpu - decision D1, gap G-022): App/*.csproj below carry `<ProjectReference Include="$(EngineRoot)...">`
       for the five engine projects, and MSBuild pulls those in transitively when this solution builds, using
       whichever engine root THIS build resolved. Do NOT re-list the engine projects here by a literal
       "../fluent-gpu/..." path: that bypasses the pin and silently builds the wrong (unfinished) engine checkout
       for the IDE / a plain `dotnet build Wavee.slnx`, which is exactly what pass-3 gap G-022 found. -->
  <Folder Name="/App/">
    <Project Path="src/apps/Wavee/Wavee.csproj" />
    <Project Path="src/apps/Wavee.Sdk/Wavee.Sdk.csproj" />
    <Project Path="src/apps/Wavee.Tests/Wavee.Tests.csproj" />
    <Project Path="src/apps/Wavee.ReleaseTool/Wavee.ReleaseTool.csproj" />
  </Folder>
  <Folder Name="/Playback-Modules/">
    <Project Path="src/apps/modules/Wavee.Module.YouTube/Wavee.Module.YouTube.csproj" />
    <Project Path="src/apps/modules/Wavee.Module.Twitch/Wavee.Module.Twitch.csproj" />
    <Project Path="src/apps/modules/Wavee.Module.Radio/Wavee.Module.Radio.csproj" />
  </Folder>
  <Folder Name="/Loc/">
    <Project Path="ops/loc/Wavee.LocPack/Wavee.LocPack.csproj" />
  </Folder>
</Solution>
