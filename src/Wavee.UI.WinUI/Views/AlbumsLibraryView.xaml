<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.AlbumsLibraryView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Wavee.UI.WinUI.Controls"
    xmlns:libcontrols="using:Wavee.UI.WinUI.Controls.Library"
    xmlns:cards="using:Wavee.UI.WinUI.Controls.Cards"
    xmlns:tracklist="using:Wavee.UI.WinUI.Controls.TrackList"
    xmlns:dto="using:Wavee.UI.Models"
    xmlns:primitives="using:CommunityToolkit.WinUI.Controls"
    xmlns:behaviors="using:Wavee.UI.WinUI.Behaviors"
    xmlns:anim="using:Wavee.UI.WinUI.Controls.Behaviors"
    xmlns:imaging="using:Wavee.UI.WinUI.Controls.Imaging"
    mc:Ignorable="d"
    Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Unified source toggle: Saved | From Liked Songs. -->
        <libcontrols:LibrarySourceSelector
            Grid.Row="0"
            Margin="0,0,0,12"
            SourceMode="{x:Bind ViewModel.SourceMode, Mode=TwoWay}"/>

        <Grid Grid.Row="1">

            <!-- ════════════════════════════════════════════════════════════════
                 SAVED SOURCE — WIDE LAYOUT
                 ════════════════════════════════════════════════════════════════ -->
            <controls:LibraryGridView
                x:Name="SavedWideGrid"
                x:Uid="Views_AlbumsLibraryView__SavedWideGrid"
                x:Load="{x:Bind ViewModel.IsSavedWide, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FilteredAlbums, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAlbum, Mode=TwoWay}"
                SearchQuery="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                ItemDoubleTapped="SavedLibraryGrid_ItemDoubleTapped"
                SearchPlaceholderText="Filter albums..."
                IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                EmptyStateText="Select an album to see tracks"
                EmptyStateGlyph="&#xE93C;"
                MinItemWidth="150"
                MinItemHeight="230"
                GridScale="{x:Bind ViewModel.GridScale, Mode=OneWay}"
                ViewMode="{x:Bind ViewModel.ViewMode, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSavedWide, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <controls:LibraryGridView.HeaderLeadingContent>
                    <libcontrols:LibrarySortViewPanel
                        AllowedSortKeys="Recents,RecentlyAdded,Alphabetical,Creator,ReleaseDate"
                        SortBy="{x:Bind ViewModel.SortBy, Mode=TwoWay}"
                        SortDirection="{x:Bind ViewModel.SortDirection, Mode=TwoWay}"
                        ViewMode="{x:Bind ViewModel.ViewMode, Mode=TwoWay}"
                        GridScale="{x:Bind ViewModel.GridScale, Mode=TwoWay}"
                        ShowGridScale="True"/>
                </controls:LibraryGridView.HeaderLeadingContent>

                <controls:LibraryGridView.DefaultGridItemTemplate>
                    <DataTemplate x:DataType="dto:LibraryAlbumDto">
                        <ItemContainer RightTapped="SavedAlbumCard_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <cards:ContentCard
                                Style="{StaticResource CompactContentCardStyle}"
                                ImageUrl="{x:Bind ImageUrl}"
                                Title="{x:Bind Name}"
                                Subtitle="{x:Bind ArtistName}"
                                Badge="{x:Bind RecentsSubtitle}"
                                NavigationUri="{x:Bind Id}"
                                PlaceholderGlyph="&#xE93C;"
                                IsCircularImage="False"
                                IsPassive="True"
                                IsLoading="{x:Bind IsLoading}"/>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.DefaultGridItemTemplate>

                <controls:LibraryGridView.CompactGridItemTemplate>
                    <DataTemplate x:DataType="dto:LibraryAlbumDto">
                        <ItemContainer RightTapped="SavedAlbumCard_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <Grid
                                Width="100" Height="100"
                                CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xE93C;"
                                    FontSize="28"
                                    Opacity="0.3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                <imaging:CompositionImage
                                    ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                                    DecodePixelSize="200"
                                    Stretch="UniformToFill"/>
                                <ToolTipService.ToolTip>
                                    <TextBlock>
                                        <Run Text="{x:Bind Name}"/>
                                        <LineBreak/>
                                        <Run Text="{x:Bind ArtistName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </TextBlock>
                                </ToolTipService.ToolTip>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.CompactGridItemTemplate>

                <controls:LibraryGridView.DefaultListItemTemplate>
                    <DataTemplate x:DataType="dto:LibraryAlbumDto">
                        <ItemContainer RightTapped="SavedAlbumCard_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <Grid Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE93C;" FontSize="16" Opacity="0.3"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <imaging:CompositionImage
                                        ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                                        DecodePixelSize="80"
                                        Stretch="UniformToFill"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{x:Bind ArtistName}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind RecentsSubtitle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind RecentsSubtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.DefaultListItemTemplate>

                <controls:LibraryGridView.CompactListItemTemplate>
                    <DataTemplate x:DataType="dto:LibraryAlbumDto">
                        <ItemContainer RightTapped="SavedAlbumCard_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <Grid Padding="8,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ArtistName}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind RecentsSubtitle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           Visibility="{x:Bind RecentsSubtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.CompactListItemTemplate>

                <controls:LibraryGridView.ItemTemplate>
                    <DataTemplate x:DataType="dto:LibraryAlbumDto">
                        <ItemContainer RightTapped="SavedAlbumCard_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <cards:ContentCard
                                Style="{StaticResource CompactContentCardStyle}"
                                ImageUrl="{x:Bind ImageUrl}"
                                Title="{x:Bind Name}"
                                Subtitle="{x:Bind ArtistName}"
                                Badge="{x:Bind RecentsSubtitle}"
                                NavigationUri="{x:Bind Id}"
                                PlaceholderGlyph="&#xE93C;"
                                IsCircularImage="False"
                                IsPassive="True"
                                IsLoading="{x:Bind IsLoading}"/>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.ItemTemplate>

                <controls:LibraryGridView.DetailContent>
                    <libcontrols:LibraryDetailPanel
                        Kicker="ALBUM"
                        ArtShape="Square"
                        PlaceholderGlyph="&#xE93C;"
                        ImageUrl="{x:Bind ViewModel.SelectedAlbumImageUrl, Mode=OneWay}"
                        TitleText="{x:Bind ViewModel.SelectedAlbumName, Mode=OneWay}"
                        SubtitleText="{x:Bind ViewModel.SelectedAlbumArtist, Mode=OneWay}"
                        SubtitleCommand="{x:Bind ViewModel.OpenArtistCommand}"
                        MetadataText="{x:Bind ViewModel.SelectedAlbumMetadata, Mode=OneWay}"
                        PrimaryActions="{x:Bind ViewModel.SavedDetailActions}">
                        <libcontrols:LibraryDetailPanel.PanelContent>
                            <tracklist:TrackListView
                                ViewModel="{x:Bind ViewModel}"
                                ItemsSource="{x:Bind ViewModel.SelectedAlbumTracks, Mode=OneWay}"
                                IsLoading="{x:Bind ViewModel.IsLoadingTracks, Mode=OneWay}"
                                IsCompact="True"
                                ShowColumnHeaders="False"
                                ShowAlbumArtColumn="False"
                                ShowArtistColumn="False"
                                ShowAlbumColumn="False"
                                ShowDateAddedColumn="False"/>
                        </libcontrols:LibraryDetailPanel.PanelContent>
                    </libcontrols:LibraryDetailPanel>
                </controls:LibraryGridView.DetailContent>
            </controls:LibraryGridView>

            <!-- ════════════════════════════════════════════════════════════════
                 FROM-LIKED-SONGS SOURCE — WIDE LAYOUT
                 ════════════════════════════════════════════════════════════════ -->
            <controls:LibraryGridView x:Uid="Views_AlbumsLibraryView__Auto_600"
                x:Name="LikedWideGrid"
                x:Load="{x:Bind ViewModel.IsLikedWide, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FilteredLikedAlbums, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedLikedAlbum, Mode=TwoWay}"
                SearchQuery="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                ItemDoubleTapped="LikedLibraryGrid_ItemDoubleTapped"
                SearchPlaceholderText="Filter albums..."
                IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                EmptyStateText="Select an album to see its liked tracks"
                EmptyStateGlyph="&#xEB52;"
                MinItemWidth="150"
                MinItemHeight="230"
                GridScale="{x:Bind ViewModel.GridScale, Mode=OneWay}"
                ViewMode="{x:Bind ViewModel.ViewMode, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLikedWide, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <controls:LibraryGridView.HeaderLeadingContent>
                    <libcontrols:LibrarySortViewPanel
                        AllowedSortKeys="Recents,RecentlyAdded,Alphabetical,Creator,ReleaseDate"
                        SortBy="{x:Bind ViewModel.SortBy, Mode=TwoWay}"
                        SortDirection="{x:Bind ViewModel.SortDirection, Mode=TwoWay}"
                        ViewMode="{x:Bind ViewModel.ViewMode, Mode=TwoWay}"
                        GridScale="{x:Bind ViewModel.GridScale, Mode=TwoWay}"
                        ShowGridScale="True"/>
                </controls:LibraryGridView.HeaderLeadingContent>

                <controls:LibraryGridView.DefaultGridItemTemplate>
                    <DataTemplate x:DataType="dto:LikedAlbumDto">
                        <ItemContainer RightTapped="LikedCardContainer_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <cards:ContentCard
                                Style="{StaticResource CompactContentCardStyle}"
                                ImageUrl="{x:Bind ImageUrl}"
                                Title="{x:Bind Name}"
                                Subtitle="{x:Bind Subtitle}"
                                Badge="{x:Bind RecentsSubtitle}"
                                NavigationUri="{x:Bind Id}"
                                PlaceholderGlyph="&#xE93C;"
                                IsCircularImage="False"
                                IsPassive="True"/>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.DefaultGridItemTemplate>

                <controls:LibraryGridView.CompactGridItemTemplate>
                    <DataTemplate x:DataType="dto:LikedAlbumDto">
                        <ItemContainer RightTapped="LikedCardContainer_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <Grid
                                Width="100" Height="100"
                                CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <FontIcon
                                    Glyph="&#xE93C;"
                                    FontSize="28"
                                    Opacity="0.3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                <imaging:CompositionImage
                                    ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                                    DecodePixelSize="200"
                                    Stretch="UniformToFill"/>
                                <ToolTipService.ToolTip>
                                    <TextBlock>
                                        <Run Text="{x:Bind Name}"/>
                                        <LineBreak/>
                                        <Run Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </TextBlock>
                                </ToolTipService.ToolTip>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.CompactGridItemTemplate>

                <controls:LibraryGridView.DefaultListItemTemplate>
                    <DataTemplate x:DataType="dto:LikedAlbumDto">
                        <ItemContainer RightTapped="LikedCardContainer_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <Grid Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid
                                    Grid.Column="0"
                                    Width="40" Height="40"
                                    CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE93C;" FontSize="16" Opacity="0.3"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <imaging:CompositionImage
                                        ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                                        DecodePixelSize="80"
                                        Stretch="UniformToFill"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind RecentsSubtitle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind RecentsSubtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.DefaultListItemTemplate>

                <controls:LibraryGridView.CompactListItemTemplate>
                    <DataTemplate x:DataType="dto:LikedAlbumDto">
                        <ItemContainer RightTapped="LikedCardContainer_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <Grid Padding="8,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Subtitle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind RecentsSubtitle}"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           FontSize="11"
                                           Margin="8,0,0,0"
                                           Visibility="{x:Bind RecentsSubtitle, Converter={StaticResource NullToVisibilityConverter}}"/>
                            </Grid>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.CompactListItemTemplate>

                <controls:LibraryGridView.ItemTemplate>
                    <DataTemplate x:DataType="dto:LikedAlbumDto">
                        <ItemContainer RightTapped="LikedCardContainer_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                            <cards:ContentCard
                                Style="{StaticResource CompactContentCardStyle}"
                                ImageUrl="{x:Bind ImageUrl}"
                                Title="{x:Bind Name}"
                                Subtitle="{x:Bind Subtitle}"
                                Badge="{x:Bind RecentsSubtitle}"
                                NavigationUri="{x:Bind Id}"
                                PlaceholderGlyph="&#xE93C;"
                                IsCircularImage="False"
                                IsPassive="True"/>
                        </ItemContainer>
                    </DataTemplate>
                </controls:LibraryGridView.ItemTemplate>

                <controls:LibraryGridView.DetailContent>
                    <libcontrols:LibraryDetailPanel
                        Kicker="ALBUM"
                        ArtShape="Square"
                        PlaceholderGlyph="&#xE93C;"
                        ImageUrl="{x:Bind ViewModel.SelectedAlbumImageUrl, Mode=OneWay}"
                        TitleText="{x:Bind ViewModel.SelectedAlbumName, Mode=OneWay}"
                        SubtitleText="{x:Bind ViewModel.SelectedAlbumArtist, Mode=OneWay}"
                        SubtitleCommand="{x:Bind ViewModel.OpenArtistCommand}"
                        MetadataText="{x:Bind ViewModel.SelectedAlbumMetadata, Mode=OneWay}"
                        PrimaryActions="{x:Bind ViewModel.LikedDetailActions}">
                        <libcontrols:LibraryDetailPanel.SubToggleContent>
                            <primitives:Segmented
                                x:Name="DetailModeSelector"
                                HorizontalAlignment="Left"
                                SelectionChanged="DetailModeSelector_SelectionChanged">
                                <primitives:SegmentedItem x:Uid="Views_AlbumsLibraryView__SegmentLiked" Content="Liked" Tag="Liked"/>
                                <primitives:SegmentedItem x:Uid="Views_AlbumsLibraryView__SegmentFullAlbum" Content="Full album" Tag="FullAlbum"/>
                            </primitives:Segmented>
                        </libcontrols:LibraryDetailPanel.SubToggleContent>
                        <libcontrols:LibraryDetailPanel.PanelContent>
                            <Grid>
                                <!-- Liked-tracks pane (default). -->
                                <tracklist:TrackListView
                                    ViewModel="{x:Bind ViewModel}"
                                    ItemsSource="{x:Bind ViewModel.SelectedLikedAlbumLikedTracks, Mode=OneWay}"
                                    IsLoading="{x:Bind ViewModel.IsLoadingTracks, Mode=OneWay}"
                                    IsCompact="True"
                                    ShowColumnHeaders="False"
                                    ShowAlbumArtColumn="False"
                                    ShowArtistColumn="False"
                                    ShowAlbumColumn="False"
                                    ShowDateAddedColumn="False"
                                    Visibility="{x:Bind ViewModel.ShowLikedTracksInDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Full-album pane (lazy-loaded). -->
                                <tracklist:TrackListView
                                    ViewModel="{x:Bind ViewModel}"
                                    ItemsSource="{x:Bind ViewModel.SelectedAlbumTracks, Mode=OneWay}"
                                    IsLoading="{x:Bind ViewModel.IsLoadingTracks, Mode=OneWay}"
                                    IsCompact="True"
                                    ShowColumnHeaders="False"
                                    ShowAlbumArtColumn="False"
                                    ShowArtistColumn="False"
                                    ShowAlbumColumn="False"
                                    ShowDateAddedColumn="False"
                                    Visibility="{x:Bind ViewModel.ShowFullAlbumTracksInDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </libcontrols:LibraryDetailPanel.PanelContent>
                    </libcontrols:LibraryDetailPanel>
                </controls:LibraryGridView.DetailContent>
            </controls:LibraryGridView>

            <!-- ════════════════════════════════════════════════════════════════
                 NARROW LAYOUT — shared scaffold (breadcrumb + stage swap),
                 internals split per SourceMode.
                 ════════════════════════════════════════════════════════════════ -->
            <Grid Visibility="{x:Bind ViewModel.IsNarrowLayout, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="0,0,0,16"
                    Padding="10,6"
                    HorizontalAlignment="Left"
                    CornerRadius="18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE93C;"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <BreadcrumbBar
                            ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}"
                            ItemClicked="BreadcrumbBar_ItemClicked">
                            <BreadcrumbBar.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </DataTemplate>
                            </BreadcrumbBar.ItemTemplate>
                        </BreadcrumbBar>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">

                    <!-- ── SAVED-SOURCE NARROW GRID STAGE ── -->
                    <Grid
                        x:Name="SavedNarrowGridStage"
                        x:Load="{x:Bind ViewModel.ShowSavedNarrowGrid, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowSavedNarrowGrid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Uid="Views_AlbumsLibraryView__Auto_602"
                            Grid.Row="0"
                            Margin="0,0,0,16"
                            PlaceholderText="Filter albums..."
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Grid.Row="1">
                            <ItemsView
                                x:Name="NarrowAlbumsView"
                                ItemsSource="{x:Bind ViewModel.FilteredAlbums, Mode=OneWay}"
                                SelectionMode="Single"
                                SelectionChanged="NarrowAlbumsView_SelectionChanged"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ItemsView.Layout>
                                    <UniformGridLayout
                                        MinItemWidth="180"
                                        MinItemHeight="240"
                                        MinRowSpacing="12"
                                        MinColumnSpacing="12"
                                        ItemsStretch="Uniform"/>
                                </ItemsView.Layout>
                                <ItemsView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:LibraryAlbumDto">
                                        <ItemContainer RightTapped="SavedAlbumCard_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                                            <Grid Tapped="NarrowAlbumCard_Tapped">
                                                <cards:ContentCard
                                                    Style="{StaticResource CompactContentCardStyle}"
                                                    ImageUrl="{x:Bind ImageUrl}"
                                                    Title="{x:Bind Name}"
                                                    Subtitle="{x:Bind ArtistName}"
                                                    Badge="{x:Bind RecentsSubtitle}"
                                                    NavigationUri="{x:Bind Id}"
                                                    PlaceholderGlyph="&#xE93C;"
                                                    IsCircularImage="False"
                                                    IsPassive="True"
                                                    IsLoading="{x:Bind IsLoading}"/>
                                            </Grid>
                                        </ItemContainer>
                                    </DataTemplate>
                                </ItemsView.ItemTemplate>
                            </ItemsView>

                            <ItemsRepeater
                                ItemsSource="{x:Bind NarrowShimmerPlaceholders, Mode=OneTime}"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        MinItemWidth="180"
                                        MinItemHeight="240"
                                        MinRowSpacing="12"
                                        MinColumnSpacing="12"
                                        ItemsStretch="Uniform"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="8,8,8,12">
                                            <StackPanel Spacing="8">
                                                <primitives:Shimmer Height="100" CornerRadius="4"/>
                                                <primitives:Shimmer Width="90" Height="14" HorizontalAlignment="Left"/>
                                                <primitives:Shimmer Width="60" Height="12" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Grid>

                    <!-- ── LIKED-SOURCE NARROW GRID STAGE ── -->
                    <Grid
                        x:Name="LikedNarrowGridStage"
                        x:Load="{x:Bind ViewModel.ShowLikedNarrowGrid, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowLikedNarrowGrid, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Uid="Views_AlbumsLibraryView__Auto_603"
                            Grid.Row="0"
                            Margin="0,0,0,16"
                            PlaceholderText="Filter albums..."
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid Grid.Row="1">
                            <ItemsView
                                x:Name="NarrowLikedAlbumsView"
                                ItemsSource="{x:Bind ViewModel.FilteredLikedAlbums, Mode=OneWay}"
                                SelectionMode="Single"
                                SelectionChanged="NarrowLikedAlbumsView_SelectionChanged"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <ItemsView.Layout>
                                    <UniformGridLayout
                                        MinItemWidth="180"
                                        MinItemHeight="240"
                                        MinRowSpacing="12"
                                        MinColumnSpacing="12"
                                        ItemsStretch="Uniform"/>
                                </ItemsView.Layout>
                                <ItemsView.ItemTemplate>
                                    <DataTemplate x:DataType="dto:LikedAlbumDto">
                                        <ItemContainer RightTapped="LikedCardContainer_RightTapped" anim:StaggeredEntrance.IsEntranceAnimated="True">
                                            <Grid Tapped="NarrowLikedAlbumCard_Tapped">
                                                <cards:ContentCard
                                                    Style="{StaticResource CompactContentCardStyle}"
                                                    ImageUrl="{x:Bind ImageUrl}"
                                                    Title="{x:Bind Name}"
                                                    Subtitle="{x:Bind Subtitle}"
                                                    Badge="{x:Bind RecentsSubtitle}"
                                                    NavigationUri="{x:Bind Id}"
                                                    PlaceholderGlyph="&#xE93C;"
                                                    IsCircularImage="False"
                                                    IsPassive="True"/>
                                            </Grid>
                                        </ItemContainer>
                                    </DataTemplate>
                                </ItemsView.ItemTemplate>
                            </ItemsView>

                            <ItemsRepeater
                                ItemsSource="{x:Bind NarrowShimmerPlaceholders, Mode=OneTime}"
                                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        MinItemWidth="180"
                                        MinItemHeight="240"
                                        MinRowSpacing="12"
                                        MinColumnSpacing="12"
                                        ItemsStretch="Uniform"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Padding="8,8,8,12">
                                            <StackPanel Spacing="8">
                                                <primitives:Shimmer Height="100" CornerRadius="4"/>
                                                <primitives:Shimmer Width="90" Height="14" HorizontalAlignment="Left"/>
                                                <primitives:Shimmer Width="60" Height="12" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </Grid>

                    <!-- ── SAVED-SOURCE NARROW DETAILS STAGE ── -->
                    <Grid
                        x:Name="SavedNarrowDetailsStage"
                        x:Load="{x:Bind ViewModel.ShowSavedNarrowDetails, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowSavedNarrowDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <libcontrols:LibraryDetailPanel
                            Kicker="ALBUM"
                            ArtShape="Square"
                            PlaceholderGlyph="&#xE93C;"
                            ImageUrl="{x:Bind ViewModel.SelectedAlbumImageUrl, Mode=OneWay}"
                            TitleText="{x:Bind ViewModel.SelectedAlbumName, Mode=OneWay}"
                            SubtitleText="{x:Bind ViewModel.SelectedAlbumArtist, Mode=OneWay}"
                            SubtitleCommand="{x:Bind ViewModel.OpenArtistCommand}"
                            MetadataText="{x:Bind ViewModel.SelectedAlbumMetadata, Mode=OneWay}"
                            PrimaryActions="{x:Bind ViewModel.SavedDetailActions}">
                            <libcontrols:LibraryDetailPanel.PanelContent>
                                <tracklist:TrackListView
                                    ViewModel="{x:Bind ViewModel}"
                                    ItemsSource="{x:Bind ViewModel.SelectedAlbumTracks, Mode=OneWay}"
                                    IsLoading="{x:Bind ViewModel.IsLoadingTracks, Mode=OneWay}"
                                    IsCompact="True"
                                    ShowColumnHeaders="False"
                                    ShowAlbumArtColumn="False"
                                    ShowArtistColumn="False"
                                    ShowAlbumColumn="False"
                                    ShowDateAddedColumn="False"/>
                            </libcontrols:LibraryDetailPanel.PanelContent>
                        </libcontrols:LibraryDetailPanel>
                    </Grid>

                    <!-- ── LIKED-SOURCE NARROW DETAILS STAGE ── -->
                    <Grid
                        x:Name="LikedNarrowDetailsStage"
                        x:Load="{x:Bind ViewModel.ShowLikedNarrowDetails, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ShowLikedNarrowDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <libcontrols:LibraryDetailPanel
                            Kicker="ALBUM"
                            ArtShape="Square"
                            PlaceholderGlyph="&#xE93C;"
                            ImageUrl="{x:Bind ViewModel.SelectedAlbumImageUrl, Mode=OneWay}"
                            TitleText="{x:Bind ViewModel.SelectedAlbumName, Mode=OneWay}"
                            SubtitleText="{x:Bind ViewModel.SelectedAlbumArtist, Mode=OneWay}"
                            SubtitleCommand="{x:Bind ViewModel.OpenArtistCommand}"
                            MetadataText="{x:Bind ViewModel.SelectedAlbumMetadata, Mode=OneWay}"
                            PrimaryActions="{x:Bind ViewModel.LikedDetailActions}">
                            <libcontrols:LibraryDetailPanel.SubToggleContent>
                                <primitives:Segmented
                                    x:Name="NarrowDetailModeSelector"
                                    HorizontalAlignment="Left"
                                    SelectionChanged="DetailModeSelector_SelectionChanged">
                                    <primitives:SegmentedItem x:Uid="Views_AlbumsLibraryView__SegmentLiked" Content="Liked" Tag="Liked"/>
                                    <primitives:SegmentedItem x:Uid="Views_AlbumsLibraryView__SegmentFullAlbum" Content="Full album" Tag="FullAlbum"/>
                                </primitives:Segmented>
                            </libcontrols:LibraryDetailPanel.SubToggleContent>
                            <libcontrols:LibraryDetailPanel.PanelContent>
                                <Grid>
                                    <tracklist:TrackListView
                                        ViewModel="{x:Bind ViewModel}"
                                        ItemsSource="{x:Bind ViewModel.SelectedLikedAlbumLikedTracks, Mode=OneWay}"
                                        IsLoading="{x:Bind ViewModel.IsLoadingTracks, Mode=OneWay}"
                                        IsCompact="True"
                                        ShowColumnHeaders="False"
                                        ShowAlbumArtColumn="False"
                                        ShowArtistColumn="False"
                                        ShowAlbumColumn="False"
                                        ShowDateAddedColumn="False"
                                        Visibility="{x:Bind ViewModel.ShowLikedTracksInDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <tracklist:TrackListView
                                        ViewModel="{x:Bind ViewModel}"
                                        ItemsSource="{x:Bind ViewModel.SelectedAlbumTracks, Mode=OneWay}"
                                        IsLoading="{x:Bind ViewModel.IsLoadingTracks, Mode=OneWay}"
                                        IsCompact="True"
                                        ShowColumnHeaders="False"
                                        ShowAlbumArtColumn="False"
                                        ShowArtistColumn="False"
                                        ShowAlbumColumn="False"
                                        ShowDateAddedColumn="False"
                                        Visibility="{x:Bind ViewModel.ShowFullAlbumTracksInDetail, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </libcontrols:LibraryDetailPanel.PanelContent>
                        </libcontrols:LibraryDetailPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
