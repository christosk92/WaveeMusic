<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.LikedSongsView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:tdg="using:Wavee.UI.WinUI.Controls.TrackDataGrid"
    xmlns:vm="using:Wavee.UI.WinUI.ViewModels"
    xmlns:controls="using:Wavee.UI.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <controls:PageErrorState
            x:Uid="Views_LikedSongsView__PageErrorState"
            Title="Couldn't load Liked Songs"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            RetryCommand="{x:Bind ViewModel.LoadCommand}"
            Canvas.ZIndex="10"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        <Grid Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- filter chip row -->
            <RowDefinition Height="*"/>      <!-- TrackDataGrid -->
        </Grid.RowDefinitions>

        <!--
            Filter chip row — ported back after commit 840d692 migrated to TrackDataGrid
            and accidentally orphaned the chips in the legacy TrackListView.HeaderContent.
            Bindings are unchanged: HasFilterChipsOrShimmer gates the whole row;
            IsTagsLoading picks between the real TokenView and the shimmer placeholders.
        -->
        <Grid Grid.Row="0"
              Padding="16,12,16,4"
              Visibility="{x:Bind ViewModel.HasFilterChipsOrShimmer, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <toolkit:TokenView
                x:Name="FilterTokenView"
                x:Load="{x:Bind ViewModel.IsTagsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                IsWrapped="False"
                CanRemoveTokens="False"
                MinHeight="36"
                Padding="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.FilterChips, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedFilterChip, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsTagsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <toolkit:TokenView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LikedSongsFilterChipViewModel">
                        <TextBlock
                            Text="{x:Bind Label}"
                            FontSize="13"
                            VerticalAlignment="Center"/>
                    </DataTemplate>
                </toolkit:TokenView.ItemTemplate>
            </toolkit:TokenView>

            <StackPanel x:Name="TagsShimmer"
                        Orientation="Horizontal"
                        Spacing="8"
                        x:Load="{x:Bind ViewModel.IsTagsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsTagsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <toolkit:Shimmer Width="48"  Height="28" CornerRadius="16"/>
                <toolkit:Shimmer Width="72"  Height="28" CornerRadius="16"/>
                <toolkit:Shimmer Width="96"  Height="28" CornerRadius="16"/>
                <toolkit:Shimmer Width="64"  Height="28" CornerRadius="16"/>
                <toolkit:Shimmer Width="84"  Height="28" CornerRadius="16"/>
                <toolkit:Shimmer Width="56"  Height="28" CornerRadius="16"/>
            </StackPanel>
        </Grid>

        <tdg:TrackDataGrid
            Grid.Row="1"
            x:Name="TrackGrid"
            PageKey="liked"
            ItemsSource="{x:Bind ViewModel.FilteredSongs, Mode=OneWay}"
            IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            LoadingRowCount="10"
            PlayCommand="{x:Bind ViewModel.PlayTrackCommand}"
            MultiSelectRemoveCommand="{x:Bind ViewModel.RemoveTracksFromLikedSongsCommand, Mode=OneWay}"
            MultiSelectRemoveLabel="Remove from Liked Songs">
            <tdg:TrackDataGrid.ToolbarLeftContent>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                            Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14"/>
                            <TextBlock x:Uid="Views_LikedSongsView__TextBlock_3" Text="Play"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{x:Bind ViewModel.ShuffleCommand, Mode=OneWay}"
                            Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14"/>
                            <TextBlock x:Uid="Views_LikedSongsView__TextBlock_4" Text="Shuffle"/>
                        </StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center"
                               Margin="4,0,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.TotalSongs, Mode=OneWay}"/>
                        <Run x:Uid="Views_LikedSongsView__Run_2" Text="songs"/>
                        <Run x:Uid="Views_LikedSongsView__Auto_600" Text=" &#x2022; "/>
                        <Run Text="{x:Bind ViewModel.TotalDuration, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBox
                        MinWidth="180"
                        MaxWidth="280"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        PlaceholderText="Filter songs..."
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </tdg:TrackDataGrid.ToolbarLeftContent>
            <tdg:TrackDataGrid.FilterBarContent>
                <ToggleButton x:Uid="Views_LikedSongsView__Auto_601"
                    MinHeight="32"
                    Padding="10,4"
                    CornerRadius="16"
                    IsChecked="{x:Bind ViewModel.ShowOnlyVideoTracks, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.HasVideoTracks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTipService.ToolTip="Show only tracks with music videos">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="13"
                            Glyph="&#xE714;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.VideoTrackFilterLabel, Mode=OneWay}" />
                    </StackPanel>
                </ToggleButton>
            </tdg:TrackDataGrid.FilterBarContent>
        </tdg:TrackDataGrid>

        <tdg:TrackSelectionBar
            x:Name="SelectionBar"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,24"/>
        </Grid>
    </Grid>
</UserControl>
