<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.RecentlyPlayedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cards="using:Wavee.UI.WinUI.Controls.Cards"
    xmlns:vm="using:Wavee.UI.WinUI.ViewModels"
    xmlns:converters="using:Wavee.UI.WinUI.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True"/>
    </UserControl.Resources>

    <Grid Padding="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Spacing="4">
            <TextBlock x:Uid="Views_RecentlyPlayedPage__Title"
                       Text="Recently played"
                       FontSize="32"
                       FontWeight="SemiBold"/>
            <TextBlock x:Uid="Views_RecentlyPlayedPage__Subtitle"
                       Text="Albums, playlists, artists, and shows you've recently started"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE823;" FontSize="36" HorizontalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            <TextBlock x:Uid="Views_RecentlyPlayedPage__EmptyTitle"
                       Text="Nothing here yet"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Uid="Views_RecentlyPlayedPage__EmptyDesc"
                       Text="Start playing an album, playlist, or artist and it'll show up here."
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <muxc:ItemsRepeater ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="192"
                                            MinColumnSpacing="16"
                                            MinRowSpacing="16"
                                            ItemsStretch="Fill"/>
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeSectionItem">
                        <cards:ContentCard
                            ImageUrl="{x:Bind BestMediumImageUrl, Mode=OneWay}"
                            Title="{x:Bind Title, Mode=OneWay}"
                            Subtitle="{x:Bind Subtitle, Mode=OneWay}"
                            PlaceholderColorHex="{x:Bind ColorHex, Mode=OneWay}"
                            PlaceholderGlyph="{x:Bind PlaceholderGlyph, Mode=OneWay}"
                            IsCircularImage="False"
                            NavigationUri="{x:Bind Uri, Mode=OneWay}"
                            NavigationTitle="{x:Bind Title, Mode=OneWay}"/>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>
