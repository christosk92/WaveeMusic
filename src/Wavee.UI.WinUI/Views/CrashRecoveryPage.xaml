<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.CrashRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CrashRecoveryBackgroundBrush" Color="#FFF7F8FA"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryTextBrush" Color="#FF121820"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryTextBrush" Color="#CC121820"/>
                    <SolidColorBrush x:Key="CrashRecoveryTertiaryTextBrush" Color="#8C121820"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryStackBackgroundBrush" Color="#FFF1F4F8"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBorderBrush" Color="#1F121820"/>
                    <SolidColorBrush x:Key="CrashRecoveryAccentBrush" Color="#FF1DB954"/>
                    <SolidColorBrush x:Key="CrashRecoveryIconBackgroundBrush" Color="#1F1DB954"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonBackgroundBrush" Color="#FF1DB954"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonForegroundBrush" Color="#FF06120B"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBackgroundBrush" Color="#0A121820"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonForegroundBrush" Color="#FF121820"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBorderBrush" Color="#24121820"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CrashRecoveryBackgroundBrush" Color="#FF101114"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryTextBrush" Color="#FFF7F7F8"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryTextBrush" Color="#CCF7F7F8"/>
                    <SolidColorBrush x:Key="CrashRecoveryTertiaryTextBrush" Color="#8CF7F7F8"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBackgroundBrush" Color="#FF191C21"/>
                    <SolidColorBrush x:Key="CrashRecoveryStackBackgroundBrush" Color="#FF111318"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBorderBrush" Color="#24FFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryAccentBrush" Color="#FF1ED760"/>
                    <SolidColorBrush x:Key="CrashRecoveryIconBackgroundBrush" Color="#241ED760"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonBackgroundBrush" Color="#FF1ED760"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonForegroundBrush" Color="#FF06120B"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBackgroundBrush" Color="#14FFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonForegroundBrush" Color="#FFF7F7F8"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBorderBrush" Color="#2EFFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CrashRecoveryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryStackBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryIconBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{ThemeResource CrashRecoveryBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Padding="48" MaxWidth="1160" HorizontalAlignment="Center">
                <Border
                    Padding="32"
                    CornerRadius="8"
                    Background="{ThemeResource CrashRecoveryPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource CrashRecoveryPanelBorderBrush}"
                    BorderThickness="1">
                    <Grid RowSpacing="28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="88"
                                Height="88"
                                CornerRadius="8"
                                Background="{ThemeResource CrashRecoveryIconBackgroundBrush}"
                                BorderBrush="{ThemeResource CrashRecoveryPanelBorderBrush}"
                                BorderThickness="1">
                                <TextBlock
                                    x:Uid="Views_CrashRecoveryPage__TextBlock_1"
                                    Text=":("
                                    FontSize="44"
                                    FontWeight="Light"
                                    Foreground="{ThemeResource CrashRecoveryAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                                <TextBlock
                                    x:Uid="Views_CrashRecoveryPage__TextBlock_2"
                                    Text="Wavee saved a recovery report."
                                    FontSize="30"
                                    FontWeight="SemiLight"
                                    Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"
                                    TextWrapping="WrapWholeWords"/>
                                <TextBlock
                                    x:Uid="Views_CrashRecoveryPage__TextBlock_3"
                                    Text="You can jump back in now, or send the details if this keeps happening."
                                    FontSize="16"
                                    Foreground="{ThemeResource CrashRecoverySecondaryTextBrush}"
                                    TextWrapping="WrapWholeWords"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="24" MinHeight="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid RowSpacing="18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="6">
                                    <TextBlock x:Uid="Views_CrashRecoveryPage__TextBlock_4" Text="Stop code" FontSize="12" Foreground="{ThemeResource CrashRecoveryTertiaryTextBrush}"/>
                                    <TextBlock x:Name="StopCodeText" FontSize="16" Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock x:Uid="Views_CrashRecoveryPage__TextBlock_5" Text="Source" FontSize="12" Foreground="{ThemeResource CrashRecoveryTertiaryTextBrush}"/>
                                    <TextBlock x:Name="SourceText" FontSize="15" Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}" TextWrapping="WrapWholeWords"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Spacing="6">
                                    <TextBlock x:Uid="Views_CrashRecoveryPage__TextBlock_6" Text="Recorded" FontSize="12" Foreground="{ThemeResource CrashRecoveryTertiaryTextBrush}"/>
                                    <TextBlock x:Name="RecordedText" FontSize="15" Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"/>
                                </StackPanel>

                                <Border
                                    Grid.Row="3"
                                    Padding="16"
                                    CornerRadius="6"
                                    Background="{ThemeResource CrashRecoveryStackBackgroundBrush}"
                                    BorderBrush="{ThemeResource CrashRecoveryPanelBorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Bottom">
                                    <TextBlock
                                        x:Uid="Views_CrashRecoveryPage__TextBlock_7"
                                        Text="The report stays on this PC. Reporting opens GitHub and prepares a zip with local Wavee logs for you to attach."
                                        FontSize="13"
                                        Foreground="{ThemeResource CrashRecoverySecondaryTextBrush}"
                                        TextWrapping="WrapWholeWords"/>
                                </Border>
                            </Grid>

                            <Border
                                Grid.Column="1"
                                Padding="18"
                                CornerRadius="6"
                                Background="{ThemeResource CrashRecoveryStackBackgroundBrush}"
                                BorderBrush="{ThemeResource CrashRecoveryPanelBorderBrush}"
                                BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        x:Uid="Views_CrashRecoveryPage__TextBlock_8"
                                        Text="Technical details"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource CrashRecoverySecondaryTextBrush}"/>

                                    <ScrollViewer
                                        Grid.Row="1"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto">
                                        <TextBlock
                                            x:Name="StackTraceText"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"
                                            TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <VariableSizedWrapGrid Grid.Row="2" Orientation="Horizontal">
                            <Button
                                x:Uid="Views_CrashRecoveryPage__Button_9"
                                x:Name="ContinueButton"
                                Content="Keep using Wavee"
                                Click="Continue_Click"
                                MinWidth="160"
                                Margin="0,0,12,12"
                                Padding="18,10"
                                Background="{ThemeResource CrashRecoveryPrimaryButtonBackgroundBrush}"
                                Foreground="{ThemeResource CrashRecoveryPrimaryButtonForegroundBrush}"
                                BorderThickness="0"
                                CornerRadius="6"/>
                            <Button
                                x:Uid="Views_CrashRecoveryPage__Button_10"
                                x:Name="ReportIssueButton"
                                Content="Report issue"
                                Click="ReportIssue_Click"
                                MinWidth="140"
                                Margin="0,0,12,12"
                                Padding="18,10"
                                Background="{ThemeResource CrashRecoverySecondaryButtonBackgroundBrush}"
                                Foreground="{ThemeResource CrashRecoverySecondaryButtonForegroundBrush}"
                                BorderBrush="{ThemeResource CrashRecoverySecondaryButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"/>
                            <Button
                                x:Uid="Views_CrashRecoveryPage__Button_11"
                                Content="Copy stacktrace"
                                Click="CopyStackTrace_Click"
                                MinWidth="150"
                                Margin="0,0,12,12"
                                Padding="18,10"
                                Background="{ThemeResource CrashRecoverySecondaryButtonBackgroundBrush}"
                                Foreground="{ThemeResource CrashRecoverySecondaryButtonForegroundBrush}"
                                BorderBrush="{ThemeResource CrashRecoverySecondaryButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"/>
                            <Button
                                x:Uid="Views_CrashRecoveryPage__Button_12"
                                Content="Open logs"
                                Click="OpenLogs_Click"
                                MinWidth="130"
                                Margin="0,0,12,12"
                                Padding="18,10"
                                Background="{ThemeResource CrashRecoverySecondaryButtonBackgroundBrush}"
                                Foreground="{ThemeResource CrashRecoverySecondaryButtonForegroundBrush}"
                                BorderBrush="{ThemeResource CrashRecoverySecondaryButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"/>
                        </VariableSizedWrapGrid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
