<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.CrashRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource CrashRecoveryBackgroundBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CrashRecoveryBackgroundBrush" Color="#FFEAF4FF"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryTextBrush" Color="#FF09253E"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryTextBrush" Color="#CC09253E"/>
                    <SolidColorBrush x:Key="CrashRecoveryTertiaryTextBrush" Color="#9909253E"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBackgroundBrush" Color="#D9FFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBorderBrush" Color="#3309253E"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonBackgroundBrush" Color="#FF005A9E"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBackgroundBrush" Color="#14005A9E"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonForegroundBrush" Color="#FF09253E"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBorderBrush" Color="#40005A9E"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CrashRecoveryBackgroundBrush" Color="#FF0078D7"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryTextBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryTextBrush" Color="#D9FFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryTertiaryTextBrush" Color="#BFFFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBackgroundBrush" Color="#14000000"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBorderBrush" Color="#40FFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonBackgroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonForegroundBrush" Color="#FF0078D7"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBackgroundBrush" Color="#20FFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonForegroundBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBorderBrush" Color="#66FFFFFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CrashRecoveryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryTertiaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="CrashRecoveryPrimaryButtonForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                    <SolidColorBrush x:Key="CrashRecoverySecondaryButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="64,72,64,48" MaxWidth="1220" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                x:Uid="Views_CrashRecoveryPage__TextBlock_1"
                Grid.Row="0"
                Text=":("
                FontSize="96"
                FontWeight="Light"
                Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"/>

            <StackPanel Grid.Row="1" Spacing="16" Margin="0,8,0,40">
                <TextBlock
                    x:Uid="Views_CrashRecoveryPage__TextBlock_2"
                    Text="Wavee ran into a problem and recorded a crash report."
                    FontSize="30"
                    FontWeight="SemiLight"
                    Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"
                    TextWrapping="WrapWholeWords"/>
                <TextBlock
                    x:Uid="Views_CrashRecoveryPage__TextBlock_3"
                    Text="You can continue using the app, or report the issue with the diagnostic logs attached."
                    FontSize="18"
                    Foreground="{ThemeResource CrashRecoverySecondaryTextBrush}"
                    TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <Grid Grid.Row="2" ColumnSpacing="36" MinHeight="340">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Views_CrashRecoveryPage__TextBlock_4" Text="Stop code" FontSize="13" Foreground="{ThemeResource CrashRecoveryTertiaryTextBrush}"/>
                        <TextBlock x:Name="StopCodeText" FontSize="18" Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Views_CrashRecoveryPage__TextBlock_5" Text="Source" FontSize="13" Foreground="{ThemeResource CrashRecoveryTertiaryTextBrush}"/>
                        <TextBlock x:Name="SourceText" FontSize="16" Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}" TextWrapping="WrapWholeWords"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock x:Uid="Views_CrashRecoveryPage__TextBlock_6" Text="Recorded" FontSize="13" Foreground="{ThemeResource CrashRecoveryTertiaryTextBrush}"/>
                        <TextBlock x:Name="RecordedText" FontSize="16" Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"/>
                    </StackPanel>

                    <Border
                        Margin="0,12,0,0"
                        Padding="16"
                        CornerRadius="4"
                        Background="{ThemeResource CrashRecoveryPanelBackgroundBrush}"
                        BorderBrush="{ThemeResource CrashRecoveryPanelBorderBrush}"
                        BorderThickness="1">
                        <TextBlock
                            x:Uid="Views_CrashRecoveryPage__TextBlock_7"
                            Text="Crash reports stay on this PC. Reporting opens GitHub and prepares a zip with local Wavee logs for you to attach."
                            FontSize="14"
                            Foreground="{ThemeResource CrashRecoverySecondaryTextBrush}"
                            TextWrapping="WrapWholeWords"/>
                    </Border>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    CornerRadius="4"
                    Background="{ThemeResource CrashRecoveryPanelBackgroundBrush}"
                    BorderBrush="{ThemeResource CrashRecoveryPanelBorderBrush}"
                    BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Uid="Views_CrashRecoveryPage__TextBlock_8"
                            Text="Crash report stacktrace"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource CrashRecoverySecondaryTextBrush}"/>

                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="StackTraceText"
                                FontFamily="Consolas"
                                FontSize="13"
                                Foreground="{ThemeResource CrashRecoveryPrimaryTextBrush}"
                                TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <VariableSizedWrapGrid Grid.Row="3" Orientation="Horizontal" Margin="0,36,0,0">
                <Button
                    x:Uid="Views_CrashRecoveryPage__Button_9"
                    x:Name="ContinueButton"
                    Content="Continue to Wavee"
                    Click="Continue_Click"
                    MinWidth="160"
                    Margin="0,0,12,12"
                    Padding="18,10"
                    Background="{ThemeResource CrashRecoveryPrimaryButtonBackgroundBrush}"
                    Foreground="{ThemeResource CrashRecoveryPrimaryButtonForegroundBrush}"
                    BorderThickness="0"
                    CornerRadius="4"/>
                <Button
                    x:Uid="Views_CrashRecoveryPage__Button_10"
                    x:Name="ReportIssueButton"
                    Content="Report issue"
                    Click="ReportIssue_Click"
                    MinWidth="140"
                    Margin="0,0,12,12"
                    Padding="18,10"
                    Background="{ThemeResource CrashRecoverySecondaryButtonBackgroundBrush}"
                    Foreground="{ThemeResource CrashRecoverySecondaryButtonForegroundBrush}"
                    BorderBrush="{ThemeResource CrashRecoverySecondaryButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"/>
                <Button
                    x:Uid="Views_CrashRecoveryPage__Button_11"
                    Content="Copy stacktrace"
                    Click="CopyStackTrace_Click"
                    MinWidth="150"
                    Margin="0,0,12,12"
                    Padding="18,10"
                    Background="{ThemeResource CrashRecoverySecondaryButtonBackgroundBrush}"
                    Foreground="{ThemeResource CrashRecoverySecondaryButtonForegroundBrush}"
                    BorderBrush="{ThemeResource CrashRecoverySecondaryButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"/>
                <Button
                    x:Uid="Views_CrashRecoveryPage__Button_12"
                    Content="Open logs"
                    Click="OpenLogs_Click"
                    MinWidth="130"
                    Margin="0,0,12,12"
                    Padding="18,10"
                    Background="{ThemeResource CrashRecoverySecondaryButtonBackgroundBrush}"
                    Foreground="{ThemeResource CrashRecoverySecondaryButtonForegroundBrush}"
                    BorderBrush="{ThemeResource CrashRecoverySecondaryButtonBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"/>
            </VariableSizedWrapGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
