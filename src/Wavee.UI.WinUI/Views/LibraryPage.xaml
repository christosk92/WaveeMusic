<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:waveeHelpers="using:Wavee.UI.WinUI.Helpers"
    mc:Ignorable="d"
    Background="Transparent"
    waveeHelpers:PageEntranceFade.Fade="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Segmented tab switcher (Pivot-style) with consistent padding -->
        <controls:Segmented
            x:Name="LibrarySelectorBar"
            Canvas.ZIndex="1"
            Margin="12,0,24,0"
            Style="{StaticResource PivotSegmentedStyle}"
            SelectionChanged="SelectorBar_SelectionChanged">
            <controls:SegmentedItem x:Uid="Views_LibraryPage__SegmentedItem_1" x:Name="AlbumsItem" Content="Albums"/>
            <controls:SegmentedItem x:Uid="Views_LibraryPage__SegmentedItem_2" x:Name="ArtistsItem" Content="Artists"/>
            <controls:SegmentedItem x:Uid="Views_LibraryPage__SegmentedItem_3" x:Name="LikedSongsItem" Content="Liked Songs"/>
            <controls:SegmentedItem x:Uid="Views_LibraryPage__SegmentedItem_Podcasts" x:Name="YourEpisodesItem" Content="Podcasts"/>
        </controls:Segmented>

        <!-- Content area.
             All four child views (Albums/Artists/LikedSongs/YourEpisodes) are
             hosted in ContentHost at once and switched by Visibility (see
             ShowTab/ShowView) — NOT by swapping a single ContentControl's
             Content. A Content swap unloads the outgoing view (its whole visual
             subtree gets torn down) and re-loads + re-lays-out + re-realizes the
             incoming one on every tab click, which was the dominant switching
             cost. With a Visibility flip the parked view stays fully resident
             (no Unloaded / re-layout / re-realize, no surface shedding —
             Files-app tab model), so switching back is instant. Page entrance
             fade (PageEntranceFade on the Page root) still only fires on first
             navigation TO Library. -->
        <Grid x:Name="ContentArea" Grid.Row="1" Canvas.ZIndex="0" Padding="24,8,24,0">
            <Grid x:Name="ContentHost"/>
        </Grid>
    </Grid>
</UserControl>
