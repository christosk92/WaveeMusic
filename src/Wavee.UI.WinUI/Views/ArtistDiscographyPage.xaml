<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.ArtistDiscographyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:cards="using:Wavee.UI.WinUI.Controls.Cards"
    xmlns:vm="using:Wavee.UI.WinUI.ViewModels"
    xmlns:views="using:Wavee.UI.WinUI.Views"
    xmlns:helpers="using:Wavee.UI.WinUI.Helpers"
    helpers:PageEntranceFade.Fade="True"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Breadcrumb header -->
            <RowDefinition Height="Auto"/>
            <!-- Scrollable grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════
             BREADCRUMB BAR
             [Artist Name] > Albums | Singles
             First crumb is clickable; routes back to ArtistPage via
             NavigationHelpers.OpenArtist. The trailing crumb is the
             current page and is non-interactive by BreadcrumbBar
             convention. ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="32,20,32,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <muxc:BreadcrumbBar x:Name="DiscographyBreadcrumb"
                                ItemClicked="DiscographyBreadcrumb_ItemClicked">
                <muxc:BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="views:DiscographyBreadcrumbItem">
                        <TextBlock Text="{x:Bind Label}"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                    </DataTemplate>
                </muxc:BreadcrumbBar.ItemTemplate>
            </muxc:BreadcrumbBar>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             FULL DISCOGRAPHY GRID
             UniformGridLayout mirrors ArtistPage's Albums/Singles
             repeaters (same MinItemWidth/Height) so cards look
             identical when the user drilled in from the cap tile.
             Items are paginated by the VM via
             IArtistService.GetDiscographyPageAsync; each Pathfinder
             page hits the shared HotCache so the second visit to the
             same group hydrates instantly. ══════════════════════════ -->
        <ScrollView Grid.Row="1"
                    ContentOrientation="Vertical"
                    VerticalScrollMode="Auto"
                    HorizontalScrollMode="Disabled">
            <muxc:ItemsRepeater x:Name="DiscographyRepeater"
                                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                Margin="32,24,32,40">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout MinItemWidth="160"
                                            MinItemHeight="220"
                                            MinRowSpacing="20"
                                            MinColumnSpacing="16"
                                            ItemsStretch="Uniform"/>
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:LazyReleaseItem">
                        <cards:ContentCard
                            IsCircularImage="False"
                            Subtitle="{x:Bind Data.SubtitleDetail, Mode=OneWay, FallbackValue=''}"
                            Title="{x:Bind Data.Name, Mode=OneWay, FallbackValue=''}"
                            ImageUrl="{x:Bind Data.ImageUrl, Mode=OneWay}"
                            NavigationUri="{x:Bind Data.Uri, Mode=OneWay}"
                            NavigationTotalTracks="{x:Bind Data.TrackCount, Mode=OneWay}"
                            AutoNavigateOnTap="True"
                            Tag="{x:Bind Data.Uri, Mode=OneWay}"/>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollView>
    </Grid>
</UserControl>
