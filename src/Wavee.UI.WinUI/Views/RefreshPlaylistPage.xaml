<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Views.RefreshPlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:swipe="using:Wavee.UI.WinUI.Controls.Swipe"
    xmlns:cards="using:Wavee.UI.WinUI.Controls.Cards"
    xmlns:imaging="using:Wavee.UI.WinUI.Controls.Imaging"
    xmlns:models="using:Wavee.UI.Services.Playlists"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="True"
    KeyDown="Page_KeyDown">

    <Grid Background="#0A0A0C">
        <!-- Immersive palette background -->
        <cards:AnimatedHeroBackground
            PrimaryColor="{x:Bind ViewModel.BackgroundPrimary, Mode=OneWay}"
            AccentColor="{x:Bind ViewModel.BackgroundAccent, Mode=OneWay}"
            ClipCornerRadius="8" />
        <Grid Background="#66080808" />

        <!-- Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Grid Grid.Row="0" Margin="22,16,22,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="Exit_Click" Width="38" Height="38" CornerRadius="19"
                        Background="#14FFFFFF" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Exit">
                    <FontIcon Glyph="&#xE76B;" FontSize="14" Foreground="White" />
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="REFRESH THIS PLAYLIST" FontSize="11" FontWeight="Bold"
                               Foreground="#A3FFFFFF" CharacterSpacing="200" />
                    <TextBlock Text="{x:Bind ViewModel.PlaylistName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border CornerRadius="999" Background="#4D000000" Padding="11,4" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB52;" FontSize="13" Foreground="#1ED760" />
                            <TextBlock Text="{x:Bind ViewModel.KeptCount, Mode=OneWay}" FontWeight="Bold" Foreground="#1ED760" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="999" Background="#4D000000" Padding="11,4" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#F0455C" />
                            <TextBlock Text="{x:Bind ViewModel.RemovedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#F0455C" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="999" Background="#4D000000" Padding="11,4" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <TextBlock Foreground="#A3FFFFFF">
                            <Run Text="{x:Bind ViewModel.RemainingCount, Mode=OneWay}" /><Run Text=" left" />
                        </TextBlock>
                    </Border>
                    <Button Click="Finish_Click" Width="34" Height="34" CornerRadius="17" Background="Transparent"
                            BorderThickness="0" Padding="0" ToolTipService.ToolTip="Finish &amp; review">
                        <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="#A3FFFFFF" />
                    </Button>
                    <Button Width="34" Height="34" CornerRadius="17" Background="Transparent" BorderThickness="0" Padding="0"
                            ToolTipService.ToolTip="More">
                        <FontIcon Glyph="&#xE712;" FontSize="15" Foreground="#A3FFFFFF" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Discard progress" Command="{x:Bind ViewModel.DiscardCommand}" />
                                <MenuFlyoutItem Text="Start over" Command="{x:Bind ViewModel.StartOverCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <ProgressBar Grid.Row="1" Margin="22,12,22,0" Height="3" Minimum="0" Maximum="1"
                         Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Foreground="#1ED760" Background="#24FFFFFF" />

            <!-- Stage: deck + up-next -->
            <Grid Grid.Row="2" Margin="22,8,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <!-- Deck -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <Grid Width="316" Height="418">
                        <!-- peek 2 -->
                        <Border Width="316" Height="418" CornerRadius="18" Background="#222" RenderTransformOrigin="0.5,0.5"
                                Opacity="0.75" Visibility="{x:Bind ToVisObj(ViewModel.PeekCard2), Mode=OneWay}">
                            <Border.RenderTransform>
                                <CompositeTransform ScaleX="0.90" ScaleY="0.90" TranslateY="34" />
                            </Border.RenderTransform>
                            <imaging:CompositionImage ImageUrl="{x:Bind ViewModel.PeekCard2.ImageUrl, Mode=OneWay}"
                                                      DecodePixelSize="400" Stretch="UniformToFill" CornerRadius="18" />
                        </Border>
                        <!-- peek 1 -->
                        <Border Width="316" Height="418" CornerRadius="18" Background="#222" RenderTransformOrigin="0.5,0.5"
                                Opacity="0.9" Visibility="{x:Bind ToVisObj(ViewModel.PeekCard1), Mode=OneWay}">
                            <Border.RenderTransform>
                                <CompositeTransform ScaleX="0.95" ScaleY="0.95" TranslateY="17" />
                            </Border.RenderTransform>
                            <imaging:CompositionImage ImageUrl="{x:Bind ViewModel.PeekCard1.ImageUrl, Mode=OneWay}"
                                                      DecodePixelSize="500" Stretch="UniformToFill" CornerRadius="18" />
                        </Border>
                        <!-- top interactive card -->
                        <swipe:SwipeCard x:Name="TopCard"
                                         ImageUrl="{x:Bind ViewModel.CurrentCard.ImageUrl, Mode=OneWay}"
                                         Title="{x:Bind ViewModel.CurrentCard.Title, Mode=OneWay}"
                                         ArtistName="{x:Bind ViewModel.CurrentCard.ArtistName, Mode=OneWay}"
                                         PreviewProgress="{x:Bind ViewModel.PreviewProgress, Mode=OneWay}"
                                         PreviewState="{x:Bind ViewModel.PreviewState, Mode=OneWay}"
                                         DecisionCommitted="TopCard_DecisionCommitted"
                                         Visibility="{x:Bind ToVis(ViewModel.IsAuditioning), Mode=OneWay}" />
                    </Grid>

                    <!-- Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18" Margin="0,16,0,0"
                                Visibility="{x:Bind ToVis(ViewModel.IsAuditioning), Mode=OneWay}">
                        <Button Click="Undo_Click" Width="46" Height="46" CornerRadius="23" Background="#B3141416"
                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Undo">
                            <FontIcon Glyph="&#xE7A7;" FontSize="16" Foreground="#A3FFFFFF" />
                        </Button>
                        <Button Click="Remove_Click" Width="62" Height="62" CornerRadius="31" Background="#B3141416"
                                BorderThickness="1" BorderBrush="#2EFFFFFF" Padding="0" ToolTipService.ToolTip="Remove (Left)">
                            <FontIcon Glyph="&#xE711;" FontSize="22" Foreground="#F0455C" />
                        </Button>
                        <Button Command="{x:Bind ViewModel.ToggleSnippetCommand}" Width="52" Height="52" CornerRadius="26"
                                Background="#B3141416" BorderThickness="0" Padding="0" ToolTipService.ToolTip="Play / pause (Space)">
                            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="White" />
                        </Button>
                        <Button Click="Keep_Click" Width="62" Height="62" CornerRadius="31" Background="#1ED760"
                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Keep (Right)">
                            <FontIcon Glyph="&#xEB52;" FontSize="24" Foreground="#062B16" />
                        </Button>
                        <Button Click="Skip_Click" Width="46" Height="46" CornerRadius="23" Background="#B3141416"
                                BorderThickness="0" Padding="0" ToolTipService.ToolTip="Skip">
                            <FontIcon Glyph="&#xE893;" FontSize="16" Foreground="#A3FFFFFF" />
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Drag the card · ← / → keys · Space to play" FontSize="12" Foreground="#6BFFFFFF"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{x:Bind ToVis(ViewModel.IsAuditioning), Mode=OneWay}" />
                </StackPanel>

                <!-- Up next rail -->
                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="14" Padding="8" Background="#38000000"
                        BorderBrush="#14FFFFFF" BorderThickness="1" Margin="8,0,0,0"
                        Visibility="{x:Bind ToVis(ViewModel.IsAuditioning), Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="UP NEXT" FontSize="11" FontWeight="Bold" Foreground="#A3FFFFFF"
                                   CharacterSpacing="200" Margin="6,4,0,4" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.UpNext, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RefreshCard">
                                    <Grid Padding="6" ColumnSpacing="11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6">
                                            <imaging:CompositionImage ImageUrl="{x:Bind ImageUrl}" DecodePixelSize="96" Stretch="UniformToFill" CornerRadius="6" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ArtistName}" FontSize="12" Foreground="#A3FFFFFF" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Reconcile banner -->
        <Border VerticalAlignment="Top" Margin="22,14,22,0" CornerRadius="12" Padding="14,11" Background="#DB141C18"
                BorderBrush="#591ED760" BorderThickness="1" Visibility="{x:Bind ToVis(ViewModel.ShowReconcileBanner), Mode=OneWay}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="16" Foreground="#1ED760" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ReconcileText, Mode=OneWay}" FontSize="13"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Dismiss" Command="{x:Bind ViewModel.DismissBannerCommand}"
                        Background="Transparent" BorderThickness="0" Foreground="#A3FFFFFF" />
            </Grid>
        </Border>

        <!-- Loading -->
        <Grid Background="#660A0A0C" Visibility="{x:Bind ToVis(ViewModel.IsLoading), Mode=OneWay}">
            <ProgressRing IsActive="True" Width="46" Height="46" Foreground="#1ED760" />
        </Grid>

        <!-- Review overlay -->
        <Grid Background="#800A0A0C" Visibility="{x:Bind ToVis(ViewModel.IsReview), Mode=OneWay}">
            <Border MaxWidth="440" Margin="26" VerticalAlignment="Center" CornerRadius="18" Padding="24"
                    Background="#F5161618" BorderBrush="#24FFFFFF" BorderThickness="1">
                <StackPanel Spacing="0">
                    <TextBlock Text="Review your refresh" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,14,0,4">
                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="#1ED760">
                            <Run Text="Kept" /><Run Text=" " /><Run Text="{x:Bind ViewModel.KeptCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="·" Foreground="#6BFFFFFF" />
                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="#F0455C">
                            <Run Text="Removed" /><Run Text=" " /><Run Text="{x:Bind ViewModel.RemovedCount, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Nothing leaves your playlist until you apply." FontSize="12.5"
                               Foreground="#A3FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <ScrollViewer MaxHeight="240" Margin="0,0,0,18">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RemovedCards, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RefreshCard">
                                    <Grid Padding="6,9" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6">
                                            <imaging:CompositionImage ImageUrl="{x:Bind ImageUrl}" DecodePixelSize="96" Stretch="UniformToFill" CornerRadius="6" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ArtistName}" FontSize="12" Foreground="#A3FFFFFF" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Undo" CommandParameter="{x:Bind Uri}"
                                                Click="UnRemove_Click" CornerRadius="999" Padding="12,7"
                                                Background="#1AFFFFFF" BorderThickness="0" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Content="Apply changes" Command="{x:Bind ViewModel.ApplyCommand}" HorizontalAlignment="Stretch"
                            Height="48" CornerRadius="999" Background="#1ED760" Foreground="#062B16" FontWeight="Bold" FontSize="15" BorderThickness="0" />
                    <Button Content="Cancel" Command="{x:Bind ViewModel.ViewPlaylistCommand}" HorizontalAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Foreground="#A3FFFFFF" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Done overlay -->
        <Grid Background="#800A0A0C" Visibility="{x:Bind ToVis(ViewModel.IsDone), Mode=OneWay}">
            <Border MaxWidth="440" Margin="26" VerticalAlignment="Center" CornerRadius="18" Padding="24"
                    Background="#F5161618" BorderBrush="#24FFFFFF" BorderThickness="1">
                <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                    <Border Width="92" Height="92" CornerRadius="46" HorizontalAlignment="Center"
                            Background="#0C2A18" BorderBrush="#661ED760" BorderThickness="2">
                        <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="#1ED760" />
                    </Border>
                    <TextBlock Text="Playlist refreshed!" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,10" />
                    <TextBlock HorizontalAlignment="Center" Foreground="#A3FFFFFF" FontSize="14">
                        <Run Text="Kept " /><Run Text="{x:Bind ViewModel.KeptCount, Mode=OneWay}" FontWeight="Bold" Foreground="#1ED760" /><Run Text=" tracks" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Center" Foreground="#A3FFFFFF" FontSize="14">
                        <Run Text="Removed " /><Run Text="{x:Bind ViewModel.RemovedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#F0455C" /><Run Text=" tracks" />
                    </TextBlock>
                    <Button Content="View playlist" Command="{x:Bind ViewModel.ViewPlaylistCommand}" HorizontalAlignment="Stretch"
                            Height="46" CornerRadius="999" Background="White" Foreground="#111111" FontWeight="Bold" BorderThickness="0" Margin="0,18,0,0" />
                    <Button Content="Start over" Command="{x:Bind ViewModel.StartOverCommand}" HorizontalAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Foreground="#A3FFFFFF" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- How it works overlay -->
        <Grid Background="#990A0A0C" Visibility="{x:Bind ToVis(ViewModel.ShowHowItWorks), Mode=OneWay}">
            <Border MaxWidth="440" Margin="26" VerticalAlignment="Center" CornerRadius="18" Padding="24"
                    Background="#F5161618" BorderBrush="#24FFFFFF" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="How it works" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="Refresh a playlist in four quick steps." FontSize="12.5" Foreground="#A3FFFFFF" Margin="0,-8,0,2" />
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#241ED760"><TextBlock Text="1" Foreground="#1ED760" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="Choose a playlist" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Start from any playlist you can edit." FontSize="12.5" Foreground="#A3FFFFFF" TextWrapping="Wrap" /></StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#241ED760"><TextBlock Text="2" Foreground="#1ED760" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="Listen to a snippet" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Each track plays a 30-second preview — your main queue keeps playing untouched." FontSize="12.5" Foreground="#A3FFFFFF" TextWrapping="Wrap" /></StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#241ED760"><TextBlock Text="3" Foreground="#1ED760" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="Swipe to decide" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Right to keep, left to remove. Buttons and ← / → keys work too." FontSize="12.5" Foreground="#A3FFFFFF" TextWrapping="Wrap" /></StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="13">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#241ED760"><TextBlock Text="4" Foreground="#1ED760" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="All set" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="Review what's leaving, then apply your changes." FontSize="12.5" Foreground="#A3FFFFFF" TextWrapping="Wrap" /></StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Got it" Command="{x:Bind ViewModel.DismissHowItWorksCommand}" HorizontalAlignment="Stretch"
                            Height="46" CornerRadius="999" Background="#1ED760" Foreground="#062B16" FontWeight="Bold" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
