<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Playback.ZoomHud"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Opacity="0"
    Visibility="Collapsed"
    IsHitTestVisible="False">

    <!-- Browser-style transient zoom HUD. Shown by ShellPage when the user
         hits Ctrl+/- or drags a pip in Settings. ShowFor(zoom) sets the
         percent label and restarts the 2-second auto-dismiss timer. Three
         inline buttons let the user step / reset inline without going to
         Settings (mirrors Chrome / Brave). Sits top-center above page
         content; the existing NotificationToast keeps the bottom-center
         lane so there's no visual collision. -->
    <Border
        x:Name="HudPill"
        CornerRadius="20"
        Padding="14,8,6,8"
        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
        BorderThickness="1"
        BackgroundSizing="InnerBorderEdge"
        Translation="0,0,32">
        <Border.Shadow>
            <ThemeShadow/>
        </Border.Shadow>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock
                x:Name="PercentText"
                Text="100%"
                FontSize="14"
                FontWeight="SemiBold"
                MinWidth="44"
                VerticalAlignment="Center"
                Margin="0,0,4,0"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

            <Button
                x:Name="ZoomOutButton"
                Width="32" Height="32"
                Padding="0"
                CornerRadius="16"
                Background="Transparent"
                BorderThickness="0"
                Click="ZoomOutButton_Click"
                ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE738;" FontSize="12"/>
            </Button>

            <Button
                x:Name="ZoomInButton"
                Width="32" Height="32"
                Padding="0"
                CornerRadius="16"
                Background="Transparent"
                BorderThickness="0"
                Click="ZoomInButton_Click"
                ToolTipService.ToolTip="Zoom in (Ctrl++)">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="12"/>
            </Button>

            <Button
                x:Name="ResetButton"
                Padding="14,6"
                CornerRadius="16"
                Style="{StaticResource AccentButtonStyle}"
                Click="ResetButton_Click"
                ToolTipService.ToolTip="Reset to 100% (Ctrl+0)">
                <TextBlock Text="Reset" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
