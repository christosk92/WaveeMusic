<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Settings.AboutSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:fa="using:FontAwesome6.Svg"
    xmlns:settings="using:Wavee.UI.WinUI.Controls.Settings"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel x:Name="SettingsGroupsRoot" Spacing="4" Padding="0,16,0,24">
                <StackPanel Spacing="4" Margin="0,0,0,20" Tag="updates">
                    <TextBlock x:Uid="Controls_Settings_AboutSettingsSection__TextBlock_1" Text="Wavee" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13">
                        <Run Text="v"/>
                        <Run Text="{x:Bind ViewModel.AppVersion}"/>
                        <Run Text=" - "/>
                        <Run Text="{x:Bind ViewModel.DistributionModeDisplay}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock x:Uid="Controls_Settings_AboutSettingsSection__TextBlock_2" Text="Updates" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,8" Tag="updates"/>
                <controls:SettingsExpander x:Uid="Controls_Settings_AboutSettingsSection__SettingsExpander_3" Header="Check for updates"
                                           Description="{x:Bind ViewModel.UpdateService.Status, Mode=OneWay}"
                                           Tag="updates">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE895;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.UpdateService.LatestVersion, Mode=OneWay}"/>
                        <Button x:Uid="Controls_Settings_AboutSettingsSection__Button_4" Content="Check now" Command="{x:Bind ViewModel.CheckForUpdateCommand}"/>
                    </StackPanel>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_5" Header="Current version">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C3;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <TextBlock Text="{x:Bind ViewModel.AppVersion}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_6" Header="Distribution">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE71B;"/>
                            </controls:SettingsCard.HeaderIcon>
                            <TextBlock Text="{x:Bind ViewModel.DistributionModeDisplay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_7" Header="Changelog"
                                               Description="{x:Bind ViewModel.UpdateService.Changelog, Mode=OneWay}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8FD;"/>
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_8" Header="Error"
                                               Description="{x:Bind ViewModel.UpdateService.ErrorMessage, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.HasUpdateError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </controls:SettingsCard.HeaderIcon>
                            <Button x:Uid="Controls_Settings_AboutSettingsSection__Button_9" Content="Retry" Command="{x:Bind ViewModel.CheckForUpdateCommand}"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_10" Header="What's new"
                                       Description="See the latest features and improvements"
                                       IsClickEnabled="True"
                                       Click="WhatsNew_Click"
                                       Margin="0,12,0,0"
                                       Tag="updates">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE789;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <TextBlock x:Uid="Controls_Settings_AboutSettingsSection__TextBlock_11" Text="Help" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,8" Tag="help"/>

                <!-- Hidden until the in-app feedback destination is built; the
                     "Report on GitHub" card below replaces it for the initial beta. -->
                <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_12" Header="Send feedback"
                                       Description="Report bugs, request features, or share your thoughts"
                                       IsClickEnabled="True"
                                       Click="Feedback_Click"
                                       Tag="help"
                                       Visibility="Collapsed">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xED15;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_100" Header="Report an issue on GitHub"
                                       Description="Packages your recent logs into a zip and opens GitHub Issues"
                                       IsClickEnabled="True"
                                       Click="ReportOnGitHub_Click"
                                       Tag="help">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <TextBlock x:Uid="Controls_Settings_AboutSettingsSection__TextBlock_13" Text="Links" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,8" Tag="links"/>
                <controls:SettingsCard x:Uid="Controls_Settings_AboutSettingsSection__SettingsCard_14" Header="Source code"
                                       Description="View the project on GitHub"
                                       IsClickEnabled="True"
                                       Click="GitHub_Click"
                                       Tag="links">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE943;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <TextBlock x:Uid="Controls_Settings_AboutSettingsSection__TextBlock_101" Text="Legal" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,8" Tag="legal"/>
                <controls:SettingsExpander x:Uid="Controls_Settings_AboutSettingsSection__SettingsExpander_102" Header="Privacy"
                                           Description="What data Wavee sends and where"
                                           Tag="legal">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Wavee is a third-party Spotify client. To make Recently Played, play counts, and recommendations work, the app sends the same minimum set of playback events to Spotify that the official client sends (the &quot;gabo&quot; telemetry pipeline): track URI, context URI, ms played, reason started/ended, audio format. Nothing else. No third-party analytics, no Wavee-operated server, no remote crash reporting. Your Spotify credentials are encrypted on disk via Windows DPAPI; the encryption is bound to your Windows user account. AI features (lyrics meaning, song themes) run entirely on-device via Phi Silica on Copilot+ PCs and never leave the machine."/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsCard Header="License"
                                       Description="Wavee is MIT-licensed open source"
                                       IsClickEnabled="True"
                                       Click="License_Click"
                                       Tag="legal">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                </controls:SettingsCard>

                <controls:SettingsExpander Header="Third-party notices"
                                           Description="Licenses, links, and why each component is included"
                                           Tag="legal">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE82D;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard ContentAlignment="Vertical">
                            <StackPanel Spacing="12">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="These are the major direct and vendored components Wavee ships with or builds against. The complete transitive package graph is still available from dotnet list package --include-transitive."/>

                                <ItemsRepeater ItemsSource="{x:Bind ThirdPartyNotices}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Spacing="8"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="settings:ThirdPartyNoticeItem">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="8"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Top">
                                                        <Grid>
                                                            <fa:SvgAwesome Icon="{x:Bind BrandIcon}"
                                                                           Width="19"
                                                                           Height="19"
                                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{x:Bind BrandIconVisibility}"/>
                                                            <FontIcon Glyph="{x:Bind FallbackGlyph}"
                                                                      FontSize="17"
                                                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                      Visibility="{x:Bind FallbackIconVisibility}"/>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="8">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="{x:Bind Name}"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                                                <TextBlock Text="{x:Bind PackageDisplay}"
                                                                           TextWrapping="WrapWholeWords"
                                                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </StackPanel>

                                                            <Border Grid.Column="1"
                                                                    Padding="8,3"
                                                                    CornerRadius="10"
                                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{x:Bind License}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            </Border>
                                                        </Grid>

                                                        <TextBlock Text="{x:Bind Reason}"
                                                                   TextWrapping="WrapWholeWords"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="10">
                                                            <HyperlinkButton NavigateUri="{x:Bind PrimaryUri}"
                                                                             Padding="0">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock Text="{x:Bind PrimaryLinkLabel}"/>
                                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11"/>
                                                                </StackPanel>
                                                            </HyperlinkButton>
                                                            <HyperlinkButton NavigateUri="{x:Bind SecondaryUri}"
                                                                             Padding="0"
                                                                             Visibility="{x:Bind SecondaryLinkVisibility}">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock Text="{x:Bind SecondaryLinkLabel}"/>
                                                                    <FontIcon Glyph="&#xE8A7;" FontSize="11"/>
                                                                </StackPanel>
                                                            </HyperlinkButton>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Uid="Controls_Settings_AboutSettingsSection__TextBlock_15" Grid.Row="1" HorizontalAlignment="Center"
                   Margin="0,8,0,12" FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="Built with WinUI 3 and .NET"/>
    </Grid>
</UserControl>
