<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Settings.GeneralSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:settings="using:Wavee.UI.WinUI.Controls.Settings"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Bare button for a single zoom pip — strips default chrome so the
             Ellipse child IS the visual. Width/Height/CornerRadius kept tight
             so the click target stays predictable along the dot row. -->
        <Style x:Key="ZoomPipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Pip dot shape. Size + Fill bound per-pip via x:Bind functions so
             the active pip swells to 14 px (accent fill); idle pips stay at
             10 px (tertiary text brush). -->
        <Style x:Key="ZoomPipDotStyle" TargetType="Ellipse">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollView>
        <StackPanel x:Name="SettingsGroupsRoot" Spacing="6" Padding="0,12,0,24">
            <!-- Behavior group: app-wide toggles relocated from Playback (Private
                 session, tray-on-close, docked-player visibility). Uids are kept
                 verbatim from the old PlaybackSettingsSection.xaml entries so the
                 existing .resw strings still resolve — renaming would mean a
                 parallel resw migration without changing any user-visible copy. -->
            <settings:SettingsGroupHeader Title="Behavior"
                                          Description="App-wide toggles for session privacy, window close action, and player chrome."
                                          IconGlyph="&#xE713;"
                                          Tag="behavior"/>

            <controls:SettingsCard x:Uid="Controls_Settings_PlaybackSettingsSection__Auto_600" Header="Private session"
                                   Description="Hides this session from Recently Played, friend activity, and recommendations until you turn it off."
                                   Tag="behavior">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;"/>
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsPrivateSession, Mode=TwoWay}"
                              OnContent="" OffContent=""/>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Controls_Settings_PlaybackSettingsSection__Auto_601" Header="Close minimizes to tray"
                                   Description="When on, the X button hides Wavee into the system tray and keeps playback going. Closes the app when off."
                                   Tag="behavior">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7E8;"/>
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                              OnContent="" OffContent=""/>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Controls_Settings_PlaybackSettingsSection__SettingsCard_104"
                                   Header="Keep docked player visible"
                                   Description="Show the bottom or sidebar player while the player is popped out"
                                   Tag="behavior">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A7;"/>
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ShowDockedPlayerWithFloatingPlayer, Mode=TwoWay}"
                              OnContent="" OffContent=""/>
            </controls:SettingsCard>

            <settings:SettingsGroupHeader x:Uid="Controls_Settings_GeneralSettingsSection__Auto_600" Title="Appearance"
                                          Description="Choose how Wavee follows your Windows theme."
                                          IconGlyph="&#xE790;"
                                          Tag="appearance"/>
            <controls:SettingsCard x:Uid="Controls_Settings_GeneralSettingsSection__SettingsCard_2" Header="Theme"
                                   Description="Choose light, dark, or match your system"
                                   Tag="appearance">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;"/>
                </controls:SettingsCard.HeaderIcon>
                <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                          MinWidth="140">
                    <ComboBoxItem x:Uid="Controls_Settings_GeneralSettingsSection__ComboBoxItem_3" Content="Light"/>
                    <ComboBoxItem x:Uid="Controls_Settings_GeneralSettingsSection__ComboBoxItem_4" Content="Dark"/>
                    <ComboBoxItem x:Uid="Controls_Settings_GeneralSettingsSection__ComboBoxItem_5" Content="System"/>
                </ComboBox>
            </controls:SettingsCard>

            <settings:SettingsGroupHeader x:Uid="Controls_Settings_GeneralSettingsSection__Auto_601" Title="Language &amp; metadata"
                                          Description="Control the app language and the language used for Spotify catalog text."
                                          IconGlyph="&#xE774;"
                                          Tag="language"/>

            <controls:SettingsCard x:Uid="Settings_General_LanguageCard"
                                   Tag="language">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;"/>
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                              MinWidth="180">
                        <ComboBoxItem x:Uid="Settings_General_LanguageSystemItem"/>
                        <ComboBoxItem x:Uid="Settings_General_LanguageEnglishItem"/>
                        <ComboBoxItem x:Uid="Settings_General_LanguageKoreanItem"/>
                    </ComboBox>
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Uid="Settings_General_SpotifyLanguageCard"
                                   Tag="language">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE189;"/>
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Spacing="8">
                    <CheckBox x:Uid="Settings_General_SpotifyLanguageSameAsAppCheckBox"
                              IsChecked="{x:Bind ViewModel.IsSpotifyMetadataSameAsApp, Mode=TwoWay}"/>
                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.IsSpotifyMetadataCustomCodeVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBox x:Uid="Settings_General_SpotifyLanguageCodeTextBox"
                                 Text="{x:Bind ViewModel.SpotifyMetadataCustomLanguageCode, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 MaxLength="2"
                                 MinWidth="120"/>
                        <TextBlock x:Uid="Settings_General_SpotifyLanguageHintText"
                                   Style="{StaticResource BodyTextBlockStyle}"/>
                    </StackPanel>
                </StackPanel>
            </controls:SettingsCard>

            <settings:SettingsGroupHeader x:Uid="Controls_Settings_GeneralSettingsSection__Auto_602" Title="Display scale"
                                          Description="Tune density and zoom for track lists, library shelves, and settings controls."
                                          IconGlyph="&#xE8A3;"
                                          Tag="display"/>

            <!-- Preset tiles. Each tile is a Button (was a static Border before
                 — clicks did nothing, which made the whole Display scale feel
                 broken). Compact / Default / Spacious map to the three anchor
                 stops in SettingsViewModel.ZoomStops: index 0 (70%), 3 (100%),
                 6 (130%). The tile whose preset index equals the active
                 ZoomLevelIndex paints an accent border so the user can see
                 which extreme is currently active. -->
            <Grid ColumnSpacing="12" Margin="0,0,0,12" Tag="display">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="16,12" Height="88"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{x:Bind settings:GeneralSettingsSection.PresetTileBorderBrush(0, ViewModel.ZoomLevelIndex), Mode=OneWay}"
                        BorderThickness="{x:Bind settings:GeneralSettingsSection.PresetTileBorderThickness(0, ViewModel.ZoomLevelIndex), Mode=OneWay}"
                        Tag="0"
                        Click="OnZoomPresetClick">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Spacing="2">
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1" Height="2" HorizontalAlignment="Left" Width="56"/>
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1" Height="2" HorizontalAlignment="Left" Width="44"/>
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1" Height="2" HorizontalAlignment="Left" Width="52"/>
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1" Height="2" HorizontalAlignment="Left" Width="36"/>
                        </StackPanel>
                        <TextBlock x:Uid="Controls_Settings_GeneralSettingsSection__TextBlock_7" Text="Compact" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="16,12" Height="88"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{x:Bind settings:GeneralSettingsSection.PresetTileBorderBrush(3, ViewModel.ZoomLevelIndex), Mode=OneWay}"
                        BorderThickness="{x:Bind settings:GeneralSettingsSection.PresetTileBorderThickness(3, ViewModel.ZoomLevelIndex), Mode=OneWay}"
                        Tag="3"
                        Click="OnZoomPresetClick">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Spacing="4">
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1.5" Height="3" HorizontalAlignment="Left" Width="56"/>
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1.5" Height="3" HorizontalAlignment="Left" Width="44"/>
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="1.5" Height="3" HorizontalAlignment="Left" Width="52"/>
                        </StackPanel>
                        <TextBlock x:Uid="Controls_Settings_GeneralSettingsSection__TextBlock_8" Text="Default" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="16,12" Height="88"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{x:Bind settings:GeneralSettingsSection.PresetTileBorderBrush(6, ViewModel.ZoomLevelIndex), Mode=OneWay}"
                        BorderThickness="{x:Bind settings:GeneralSettingsSection.PresetTileBorderThickness(6, ViewModel.ZoomLevelIndex), Mode=OneWay}"
                        Tag="6"
                        Click="OnZoomPresetClick">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Spacing="6">
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="56"/>
                            <Border Background="{ThemeResource TextFillColorDisabledBrush}" CornerRadius="2" Height="4" HorizontalAlignment="Left" Width="44"/>
                        </StackPanel>
                        <TextBlock x:Uid="Controls_Settings_GeneralSettingsSection__TextBlock_9" Text="Spacious" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Pip row + Reset. The Spotify-style discrete picker: 7 dots
                 linked by a thin track, each labelled with its percent. Click
                 a dot → ViewModel.ZoomLevelIndex jumps to that index → the
                 existing OnZoomLevelIndexChanged path fires ZoomChanged →
                 ShellPage applies the scale + shows the HUD. No more
                 ambiguous slider with no tick marks. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16,16,16"
                    Tag="display">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pip strip — relative positioning via a Grid so the
                         connector track and the dots share the same row. -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Track + 7 dots in Row 0. The track is a 1-px line
                             centered behind the dots; the dots overlay it. -->
                        <Grid Grid.Row="0" Height="22">
                            <Border Height="1"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    VerticalAlignment="Center"
                                    Margin="11,0"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Tag="0" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(0, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(0, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(0, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                                <Button Grid.Column="1" Tag="1" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(1, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(1, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(1, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                                <Button Grid.Column="2" Tag="2" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(2, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(2, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(2, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                                <Button Grid.Column="3" Tag="3" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(3, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(3, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(3, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                                <Button Grid.Column="4" Tag="4" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(4, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(4, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(4, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                                <Button Grid.Column="5" Tag="5" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(5, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(5, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(5, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                                <Button Grid.Column="6" Tag="6" Click="OnZoomPipClick" Style="{StaticResource ZoomPipButtonStyle}">
                                    <Ellipse Style="{StaticResource ZoomPipDotStyle}" Fill="{x:Bind settings:GeneralSettingsSection.PipFill(6, ViewModel.ZoomLevelIndex), Mode=OneWay}" Width="{x:Bind settings:GeneralSettingsSection.PipSize(6, ViewModel.ZoomLevelIndex), Mode=OneWay}" Height="{x:Bind settings:GeneralSettingsSection.PipSize(6, ViewModel.ZoomLevelIndex), Mode=OneWay}"/>
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Per-pip % labels in Row 1. -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="70%"  HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="80%"  HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="90%"  HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="100%" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="4" Text="110%" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="120%" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Column="6" Text="130%" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </Grid>
                    </Grid>

                    <Button Grid.Column="1"
                            x:Uid="Controls_Settings_GeneralSettingsSection__Button_11"
                            Content="Reset"
                            Padding="14,6"
                            CornerRadius="14"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ResetZoomCommand}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollView>
</UserControl>
