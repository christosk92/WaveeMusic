<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shelf="using:Wavee.UI.WinUI.Controls.Shelf">

    <!-- Chevron button style used by shelf headers (SectionShelf + any page
         that wires its own header to a ShelfScroller). Matches the Fluent card
         surface; greyed out automatically via ICommand.CanExecute. -->
    <Style x:Key="ShelfChevronButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
    </Style>

    <Style TargetType="shelf:ShelfScroller">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="shelf:ShelfScroller">
                    <!-- Wrapper Grid hosts the scrolling items AND a baked-in
                         right-edge fade overlay. The fade Border is gated on
                         the templated parent's CanPageRight so it only shows
                         when there's overflow to the right (short shelves
                         that fit completely don't get the fade). The fade is
                         a theme-aware LinearGradientBrush that fades from
                         transparent to the page surface colour
                         (SolidBackgroundFillColorBase), so the right edge
                         blends into the page on both Light and Dark themes
                         without painting a blurred backdrop sample (which
                         produced a halo of bright card pixels in Dark mode).
                         Width=96 matches the previous per-page Border so
                         every existing layout keeps the same proportions. -->
                    <Grid>
                        <ScrollView x:Name="PART_Scroll"
                                    ContentOrientation="Horizontal"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled"
                                    VerticalAlignment="Top">
                            <ItemsRepeater x:Name="PART_Repeater"
                                           VerticalAlignment="Top">
                                <ItemsRepeater.Layout>
                                    <shelf:ShelfLayout/>
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollView>
                        <Border HorizontalAlignment="Right"
                                Width="96"
                                IsHitTestVisible="False"
                                Visibility="{Binding CanPageRight, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="{ThemeResource ShelfFadeStartColor}"/>
                                    <GradientStop Offset="1" Color="{ThemeResource ShelfFadeEndColor}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
