<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.AlbumDetailPanel.ExpandableAlbumGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Wavee.UI.WinUI.Controls.AlbumDetailPanel"
    xmlns:cards="using:Wavee.UI.WinUI.Controls.Cards"
    xmlns:vm="using:Wavee.UI.WinUI.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Discography release card. The repeater hosts only these (one
             template, clean recycling); the detail panel is a separate
             overlay. CardClick expands inline (AutoNavigateOnTap=False); the
             secondary action opens the full album page. -->
        <DataTemplate x:Key="DiscographyCardTemplate" x:DataType="vm:LazyReleaseItem">
            <cards:ContentCard
                IsCircularImage="False"
                IsLoading="{x:Bind IsLoading, Mode=OneWay}"
                Title="{x:Bind Name, Mode=OneWay}"
                Subtitle="{x:Bind SubtitleDetail, Mode=OneWay}"
                ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                NavigationUri="{x:Bind Uri, Mode=OneWay}"
                NavigationTotalTracks="{x:Bind TrackCount, Mode=OneWay}"
                AutoNavigateOnTap="False"
                SecondaryActionVisible="True"
                SecondaryActionTooltip="Open album page"
                Tag="{x:Bind Uri, Mode=OneWay}"
                CardClick="OnCardClick"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Virtualizing card grid. ExpandingGridLayout reserves an empty band
             below the expanded row; the cards stay realised across expand /
             collapse. -->
        <ItemsRepeater x:Name="Repeater"
                       ItemTemplate="{StaticResource DiscographyCardTemplate}">
            <ItemsRepeater.Layout>
                <local:ExpandingGridLayout x:Name="GridLayout"/>
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <!-- Single persistent detail panel overlay, positioned (Margin.Top)
             into the band the layout reserves. Never recycled. -->
        <local:AlbumDetailPanel x:Name="DetailPanel"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Stretch"
                                Visibility="Collapsed"
                                CloseRequested="OnDetailPanelCloseRequested"
                                SizeChanged="OnDetailPanelSizeChanged"/>
    </Grid>
</UserControl>
