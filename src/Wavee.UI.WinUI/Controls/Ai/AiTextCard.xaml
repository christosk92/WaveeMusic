<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Ai.AiTextCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ai="using:Wavee.UI.WinUI.Controls.Ai"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:waveeControls="using:Wavee.UI.WinUI.Controls"
    mc:Ignorable="d">

    <Border
        x:Name="CardBorder"
        Padding="22,18"
        Background="{ThemeResource AiCardBackgroundBrush}"
        BorderBrush="{ThemeResource AiBorderBrush}"
        BorderThickness="1"
        CornerRadius="14"
        Tapped="OnCardTapped">

        <StackPanel Spacing="10">
            <Grid x:Name="HeaderPanel" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="TitleTextBlock"
                        CharacterSpacing="140"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{ThemeResource AiAccentSolidBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Title, ElementName=Root}" />
                    <waveeControls:AiSparkleIcon
                        x:Name="HeaderSparkle"
                        Width="16"
                        Height="16"
                        State="Normal"
                        ToolTipService.ToolTip="On-device summary generated by Phi Silica" />
                </StackPanel>

                <FontIcon
                    x:Name="ExpandChevron"
                    Grid.Column="2"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    Glyph="&#xE70D;"
                    FontSize="10"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource AiAccentSolidBrush}"
                    RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform x:Name="ExpandChevronTransform" Angle="0" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </Grid>

            <Grid x:Name="BodyHost">
                <ai:AiThinkingPlaceholder
                    x:Name="ThinkingPlaceholder"
                    Caption="{Binding PlaceholderCaption, ElementName=Root}" />

                <!-- BodyClipHost is the animated clip surface: its MaxHeight
                     transitions between the collapsed 2-line height and the
                     measured full height. CornerRadius matches the fade
                     gradient overlay so the fade hugs the card edges. -->
                <Border
                    x:Name="BodyClipHost"
                    SizeChanged="OnBodyClipHostSizeChanged">
                    <Grid>
                        <ai:TypewriterTextBlock
                            x:Name="BodyTextBlock"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            LineHeight="20"
                            MaxLines="32"
                            TextTrimming="None"
                            TextWrapping="Wrap" />

                        <!-- Bottom fade overlay: opacity is tweened by code-behind
                             between 0 (expanded) and 1 (collapsed). Sits over the
                             last visible line so the text dissolves into the card
                             instead of clipping sharply. -->
                        <Rectangle
                            x:Name="FadeOverlay"
                            Height="34"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Fill="{ThemeResource AiCardFadeBrush}"
                            Opacity="0"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock
                    x:Name="EmptyTextBlock"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="19"
                    Text="{Binding EmptyText, ElementName=Root}"
                    TextWrapping="Wrap" />
            </Grid>

            <ContentPresenter x:Name="FooterPresenter" />
        </StackPanel>
    </Border>
</UserControl>
