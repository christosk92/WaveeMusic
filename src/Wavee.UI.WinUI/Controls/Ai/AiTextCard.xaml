<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Ai.AiTextCard"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ai="using:Wavee.UI.WinUI.Controls.Ai"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:waveeControls="using:Wavee.UI.WinUI.Controls"
    mc:Ignorable="d">

    <Border
        x:Name="CardBorder"
        Padding="22,18"
        BorderBrush="{ThemeResource AiBorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#171B333C" Offset="0" />
                <GradientStop Color="#1014141A" Offset="0.72" />
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel Spacing="10">
            <StackPanel
                x:Name="HeaderPanel"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleTextBlock"
                    CharacterSpacing="140"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{ThemeResource AiAccentSolidBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{Binding Title, ElementName=Root}" />
                <waveeControls:AiSparkleIcon
                    x:Name="HeaderSparkle"
                    Width="16"
                    Height="16"
                    State="Normal"
                    ToolTipService.ToolTip="On-device summary generated by Phi Silica" />
            </StackPanel>

            <Grid x:Name="BodyHost" MinHeight="96">
                <ai:AiThinkingPlaceholder
                    x:Name="ThinkingPlaceholder"
                    Caption="{Binding PlaceholderCaption, ElementName=Root}" />

                <ai:TypewriterTextBlock
                    x:Name="BodyTextBlock"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    LineHeight="20"
                    MaxLines="4"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="EmptyTextBlock"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="19"
                    Text="{Binding EmptyText, ElementName=Root}"
                    TextWrapping="Wrap" />
            </Grid>

            <ContentPresenter x:Name="FooterPresenter" />
        </StackPanel>
    </Border>
</UserControl>
