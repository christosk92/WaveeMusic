<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Ai.TypewriterTextBlock"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <TextBlock
        x:Name="PART_TextBlock"
        FontSize="{Binding FontSize, ElementName=Root}"
        Foreground="{Binding Foreground, ElementName=Root}"
        LineHeight="{Binding LineHeight, ElementName=Root}"
        MaxLines="{Binding MaxLines, ElementName=Root}"
        TextTrimming="{Binding TextTrimming, ElementName=Root}"
        TextWrapping="{Binding TextWrapping, ElementName=Root}" />
</UserControl>
