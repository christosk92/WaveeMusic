<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.TrackDataGrid.TrackSelectionBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    mc:Ignorable="d"
    HorizontalAlignment="Center"
    VerticalAlignment="Bottom"
    Visibility="Collapsed">

    <UserControl.Resources>
        <!-- Self-contained subtle button (transparent rest, themed hover fill).
             Defined inline rather than reusing the app's SubtleButtonStyle
             because PlayerBarStyles.xaml isn't in scope for this control. -->
        <Style x:Key="BarActionButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </UserControl.Resources>

    <!-- Floating multi-select command bar. Shadow + acrylic recipe mirrors
         AddToPlaylistBar / NotificationToast. A compact row of labelled
         icon+text buttons — sizes to content, ~52 px tall. -->
    <Border x:Name="ShadowHost"
            CornerRadius="10"
            Background="Transparent">
        <toolkit:Effects.Shadow>
            <media:AttachedCardShadow BlurRadius="24"
                                      Offset="0,6"
                                      Opacity="0.28"
                                      Color="Black"
                                      CornerRadius="10"/>
        </toolkit:Effects.Shadow>
        <animations:Implicit.ShowAnimations>
            <animations:OpacityAnimation Duration="0:0:0.28" From="0" To="1"/>
            <animations:TranslationAnimation Duration="0:0:0.28" From="0,28,0" To="0,0,0"/>
        </animations:Implicit.ShowAnimations>
        <animations:Implicit.HideAnimations>
            <animations:OpacityAnimation Duration="0:0:0.2" From="1" To="0"/>
            <animations:TranslationAnimation Duration="0:0:0.2" From="0,0,0" To="0,16,0"/>
        </animations:Implicit.HideAnimations>

        <Border x:Name="ChipBorder"
                CornerRadius="10"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                MinHeight="48"
                Padding="12,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                <TextBlock x:Name="CountText"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <Rectangle Width="1" Height="24"
                           Margin="4,0"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <Button x:Name="PlayButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnPlayClick"/>
                <Button x:Name="PlayNextButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnPlayNextClick"/>
                <Button x:Name="AddToQueueButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnAddToQueueClick"/>
                <Button x:Name="AddToPlaylistButton"
                        Style="{StaticResource BarActionButtonStyle}">
                    <Button.Flyout>
                        <MenuFlyout x:Name="AddToPlaylistFlyout"
                                    Opening="OnAddToPlaylistFlyoutOpening"/>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SaveButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnSaveClick"/>
                <Button x:Name="RemoveButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnRemoveClick"/>

                <Rectangle Width="1" Height="24"
                           Margin="4,0"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <Button x:Name="SelectAllButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnSelectAllClick"/>
                <Button x:Name="CloseButton"
                        Style="{StaticResource BarActionButtonStyle}"
                        Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
