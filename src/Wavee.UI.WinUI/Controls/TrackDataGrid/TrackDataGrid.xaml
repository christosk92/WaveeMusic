<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.TrackDataGrid.TrackDataGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Wavee.UI.Contracts"
    xmlns:local="using:Wavee.UI.WinUI.Controls.TrackDataGrid"
    xmlns:track="using:Wavee.UI.WinUI.Controls.Track"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <!--
            Self-contained ToggleButton style — matches IconButtonStyle's visual shape
            (32×32, transparent, subtle fill on hover/check). Defined inline because the
            app's SubtleToggleButtonStyle lives in Styles/PlayerBarStyles.xaml, which is
            only merged into PlayerBar.xaml's local scope and not reachable from here.
        -->
        <Style x:Key="TrackDataGridToggleButtonStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+A selects every track and enters selection mode. Lives on
                 the control root (not the inner ItemsView) so it fires whether
                 focus is on a row, the toolbar, or anywhere in the grid. -->
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="OnSelectAllAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Files-app-style toolbar: right-aligned icon-only buttons. No Play/Shuffle/Like —
            those live in the page's left hero column. The Details toggle opens the right
            panel in TrackDetails mode with whatever row is currently selected in the grid.
            ShowToolbar=false on the grid collapses this whole block (album page uses that).
        -->
        <Grid
            x:Name="ToolbarHost"
            Grid.Row="0"
            Padding="8,6,8,6"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                Page-specific left-side content (e.g. Liked Songs' Play/Shuffle + stats).
                Empty by default, so pages that don't set ToolbarLeftContent keep today's
                layout with the icon cluster spanning the full row.
            -->
            <ContentPresenter
                Grid.Column="0"
                Content="{x:Bind ToolbarLeftContent, Mode=OneWay}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" />

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="2">
                <ToggleButton
                    x:Name="FilterToggle"
                    Style="{StaticResource TrackDataGridToggleButtonStyle}"
                    Checked="FilterToggle_Toggled"
                    Unchecked="FilterToggle_Toggled"
                    ToolTipService.ToolTip="Filter">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE71C;" />
                </ToggleButton>

                <!--  Selection-mode toggle — flips the grid into keyboard-free
                      multi-select: per-row checkboxes + the floating action bar.
                      Sits next to the filter toggle; kept in sync with the
                      grid's IsSelectionMode in code-behind.  -->
                <ToggleButton
                    x:Name="SelectionModeToggle"
                    Style="{StaticResource TrackDataGridToggleButtonStyle}"
                    Checked="SelectionModeToggle_Checked"
                    Unchecked="SelectionModeToggle_Unchecked"
                    ToolTipService.ToolTip="Select tracks">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE762;" />
                </ToggleButton>

                <Button
                    x:Name="SortButton"
                    Style="{ThemeResource IconButtonStyle}"
                    ToolTipService.ToolTip="Sort">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8CB;" />
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="10"
                            Opacity="0.7"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutSubItem x:Name="SortBySubItem" Text="Sort by">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8CB;" />
                                </MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem
                                x:Name="SortAscendingItem"
                                Text="Ascending"
                                GroupName="TrackGridSortDirection"
                                Click="SortDirectionItem_Click"
                                Tag="Ascending"
                                IsChecked="True" />
                            <RadioMenuFlyoutItem
                                x:Name="SortDescendingItem"
                                Text="Descending"
                                GroupName="TrackGridSortDirection"
                                Click="SortDirectionItem_Click"
                                Tag="Descending" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="ViewButton"
                    Style="{ThemeResource IconButtonStyle}"
                    ToolTipService.ToolTip="View">
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="14"
                            Glyph="&#xE8FD;" />
                        <FontIcon
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            FontSize="10"
                            Opacity="0.7"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Width="280" Spacing="14">
                                <TextBlock Text="Size" FontWeight="SemiBold" FontSize="13" />
                                <Slider
                                    x:Name="DensitySlider"
                                    Minimum="0"
                                    Maximum="4"
                                    StepFrequency="1"
                                    SnapsTo="StepValues"
                                    TickFrequency="1"
                                    TickPlacement="Outside"
                                    ValueChanged="DensitySlider_ValueChanged" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="XS" FontSize="10" HorizontalAlignment="Center" Opacity="0.6" />
                                    <TextBlock Grid.Column="1" Text="S" FontSize="10" HorizontalAlignment="Center" Opacity="0.6" />
                                    <TextBlock Grid.Column="2" Text="M" FontSize="10" HorizontalAlignment="Center" Opacity="0.6" />
                                    <TextBlock Grid.Column="3" Text="L" FontSize="10" HorizontalAlignment="Center" Opacity="0.6" />
                                    <TextBlock Grid.Column="4" Text="XL" FontSize="10" HorizontalAlignment="Center" Opacity="0.6" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <ToggleButton
                    x:Name="DetailsToggle"
                    Style="{StaticResource TrackDataGridToggleButtonStyle}"
                    Click="DetailsToggle_Click"
                    ToolTipService.ToolTip="Details">
                    <FontIcon
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE946;" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!--  Inline filter TextBox — collapses until the toolbar toggle expands it.  -->
        <Border
            x:Name="FilterHost"
            Grid.Row="1"
            Padding="12,6,12,8"
            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="FilterBox"
                    PlaceholderText="Filter tracks"
                    TextChanged="FilterBox_TextChanged" />

                <ContentPresenter
                    Grid.Column="1"
                    Content="{x:Bind FilterBarContent, Mode=OneWay}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!--  Header + list. The ItemsView wraps its own ScrollView (both axes
              Auto) so virtualization is preserved per Microsoft's guidance.
              HeaderHost sits OUTSIDE the ItemsView and stays vertically
              pinned; TrackDataGrid.xaml.cs syncs its X translation to the
              ItemsView.ScrollView.HorizontalOffset via ViewChanged.

              Three-row layout:
                Row 0 = column header (HeaderHost ScrollViewer)
                Row 1 = loading-row skeleton (LoadingRowsRepeater)
                Row 2 = real items presenter (RowsItemsViewHost)
              Row 1 is Auto and collapses to 0 px when LoadingRowsRepeater is
              Collapsed (i.e. IsLoading=false). When IsLoading=true the
              skeleton rows sit ABOVE Row 2 so the FooterContent (which sits
              inside RowsItemsViewHost below the ItemsView) lays out cleanly
              below the skeleton rather than overlapping. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header row: built in code-behind from Columns. The wrapping
                  ScrollViewer with both scroll modes DISABLED provides
                  automatic clipping of the HeaderHost's X translation so
                  scrolled-out header content doesn't visually bleed out of
                  the page bounds. The actual horizontal offset is driven
                  programmatically from RowsItemsView.ScrollView via
                  HeaderScrollTransform.  -->
            <ScrollViewer
                Grid.Row="0"
                Height="40"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <!-- HorizontalAlignment must be Stretch (NOT Left). With Left, the Grid
                     measures itself in shrink-to-content mode and any * column collapses
                     to MinWidth. The rows inside the ItemsView's ItemContainer stretch
                     to viewport width via HorizontalContentAlignment="Stretch", so the
                     * Title column expands to its MaxWidth (640); a Left-aligned header
                     would stay at MinWidth (120). Stretch makes both sides resolve
                     identically.

                     Padding="8,0" mirrors TrackItem.xaml's RowRoot Padding="8,8" — without
                     it, every header column starts 8 px left of the matching row column. -->
                <Grid
                    x:Name="HeaderHost"
                    HorizontalAlignment="Stretch"
                    MinWidth="500"
                    Padding="8,0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="HeaderScrollTransform" />
                    </Grid.RenderTransform>
                </Grid>
            </ScrollViewer>

            <!-- Items presenter. ItemsView (which wraps ItemsRepeater inside a
                 ScrollView) has no Footer slot, so we host it + FooterContent
                 in a two-row Grid (*, Auto). Two modes:
                   - IsParentScrolling=false (e.g. LikedSongs): the outer Grid
                     gives this host a finite height, so the * row constrains
                     ItemsView's ScrollView and it scrolls internally; the
                     footer stays pinned in the Auto row.
                   - IsParentScrolling=true (Album / Playlist, with the page
                     wrapping us in an outer ScrollView): vertical available
                     is infinity, the * row collapses to ItemsView's natural
                     desired height, the Auto row sits below, and the outer
                     ScrollView scrolls items + footer together.

                 An earlier StackPanel version broke the first mode because
                 StackPanels never propagate a finite height to children, so
                 the inner ScrollView saw viewport == content and never scrolled.

                 Grouping (IsGrouped=true) is handled in code-behind: the
                 visible-rows collection interleaves TrackDataGridGroupRow
                 markers between buckets, and the ItemTemplate selector routes
                 markers to GroupHeaderTemplate and tracks to RowTemplate. -->
            <!-- AllowDrop is unconditional; the DragOver handler gates on CanReorder.
                 An x:Bind from AllowDrop to a same-class DependencyProperty was
                 latching false on first render (CanReorderTracks gets fired later,
                 once the playlist's owner-edit gate resolves) and never re-binding,
                 so DragOver simply never fired. Always-true here means the routed
                 event is delivered, the handler reads the current CanReorder DP
                 value, and rejects the drop unambiguously when ineligible. -->
            <Grid x:Name="RowsItemsViewHost"
                  Grid.Row="2"
                  AllowDrop="True"
                  DragOver="RowsItemsViewHost_DragOver"
                  DragLeave="RowsItemsViewHost_DragLeave"
                  Drop="RowsItemsViewHost_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ItemsView + drop-indicator overlay share one cell so the
                     2-px insertion line can be positioned absolutely against
                     the rendered rows without disturbing the layout. The
                     Canvas sits above the ItemsView in z-order and is
                     hit-test-invisible so drag events still reach the
                     host's DragOver/Drop handlers. -->
                <Grid x:Name="RowsHostCell" Grid.Row="0">
                    <ItemsView
                        x:Name="RowsItemsView"
                        SelectionMode="Extended"
                        KeyDown="OnRowsKeyDown"
                        SelectionChanged="RowsItemsView_SelectionChanged">
                        <ItemsView.Layout>
                            <StackLayout Orientation="Vertical" Spacing="0"/>
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <!-- The RowTemplate is the per-track template. The selector's
                                 GroupHeaderTemplate is plugged in from code-behind whenever
                                 the GroupHeaderTemplate DP changes (see ApplyGroupHeaderTemplate).
                                 That keeps each consumer page's existing header markup
                                 unchanged while letting ItemsView render headers inline. -->
                            <local:TrackDataGridItemTemplateSelector x:Name="ItemTemplateSelector">
                                <local:TrackDataGridItemTemplateSelector.RowTemplate>
                                    <DataTemplate x:DataType="contracts:ITrackItem">
                                        <ItemContainer
                                            Padding="0"
                                            Margin="0,4"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            MinHeight="0">
                                            <track:TrackItem
                                                Track="{x:Bind}"
                                                Mode="Row"
                                                Loaded="RowsItemsViewTrackItem_Loaded"
                                                Unloaded="RowsItemsViewTrackItem_Unloaded"/>
                                        </ItemContainer>
                                    </DataTemplate>
                                </local:TrackDataGridItemTemplateSelector.RowTemplate>
                            </local:TrackDataGridItemTemplateSelector>
                        </ItemsView.ItemTemplate>
                    </ItemsView>

                    <!-- Drop-indicator pool. Rectangles are allocated lazily in
                         code-behind (one per realized row + one for the end-of-list
                         anchor), parked at Opacity=0 in the rest state, and animated
                         via UIElement.OpacityTransition + ScaleTransition on every
                         DragOver tick. Keeping Visibility="Visible" and using opacity
                         for show/hide is intentional — Visibility=Collapsed kills the
                         implicit transition because the element drops out of the
                         visual tree. -->
                    <Canvas x:Name="DropIndicatorOverlay"
                            IsHitTestVisible="False"/>
                </Grid>

                <!-- Footer slot. Mirrors the pre-refactor ListView.Footer
                     pattern. In IsParentScrolling=true mode it scrolls with
                     items under the outer ScrollView; in internal-scroll mode
                     it stays pinned below the scrolling list. Consumers bind
                     the FooterContent DP as before. -->
                <ContentPresenter Grid.Row="1"
                                  Content="{x:Bind FooterContent, Mode=OneWay}"
                                  HorizontalContentAlignment="Stretch"/>
            </Grid>

            <!--
                Track-row skeleton. Column widths are bound to the active
                LoadingRowConfig (built from PageKey + Columns + AddedByVisible +
                ForceShowArtistColumn in code-behind), so the skeleton row
                geometry mirrors the real-row geometry slot-for-slot. Columns
                that aren't in the active page's column set get GridLength(0) —
                they collapse fully, so the title doesn't shift left when the
                real content paints. The artist subtitle bar is hidden on
                single-artist album pages to match the one-line real layout.

                Note: classic {Binding} (not x:Bind) because DataTemplates set
                their DataContext to the per-item LoadingRowConfig, which is
                what {Binding Path=…} resolves against.
            -->
            <ItemsRepeater
                x:Name="LoadingRowsRepeater"
                Grid.Row="1"
                Margin="0,2,0,0"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <!-- Row 1 (Auto, this grid's dedicated skeleton row). Renders
                     ABOVE the ListView in Row 2 so the empty ListView's
                     Footer slot (FooterContent + FooterShimmer) lays out
                     below the skeleton rather than overlapping them. -->
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="4"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:LoadingRowConfig">
                        <Border
                            Padding="8,8"
                            CornerRadius="6"
                            Background="Transparent">
                            <Grid ColumnSpacing="0"
                                  MinWidth="{x:Bind ContentMinWidth, Mode=OneTime}">
                                <Grid.ColumnDefinitions>
                                    <!-- Index (always 52) -->
                                    <ColumnDefinition Width="52"/>
                                    <!-- Like (always 32) -->
                                    <ColumnDefinition Width="32"/>
                                    <!-- TrackArt (42 on playlist/liked/podcast, 0 on album) -->
                                    <ColumnDefinition Width="{x:Bind ArtColumnWidth, Mode=OneTime}"/>
                                    <!-- Title (*, MinWidth=120, MaxWidth bound) -->
                                    <ColumnDefinition Width="*" MinWidth="120" MaxWidth="{x:Bind TitleColumnMaxWidth, Mode=OneTime}"/>
                                    <!-- Album (180 on playlist, 0 on album) -->
                                    <ColumnDefinition Width="{x:Bind AlbumColumnWidth, Mode=OneTime}"/>
                                    <!-- AddedBy (140 on collab playlist, 0 elsewhere) -->
                                    <ColumnDefinition Width="{x:Bind AddedByColumnWidth, Mode=OneTime}"/>
                                    <!-- DateAdded (120 on playlist/liked, 0 on album) -->
                                    <ColumnDefinition Width="{x:Bind DateAddedColumnWidth, Mode=OneTime}"/>
                                    <!-- PlayCount (100 on album, 0 elsewhere) -->
                                    <ColumnDefinition Width="{x:Bind PlayCountColumnWidth, Mode=OneTime}"/>
                                    <!-- Duration (60 or 76 depending on page) -->
                                    <ColumnDefinition Width="{x:Bind DurationColumnWidth, Mode=OneTime}"/>
                                </Grid.ColumnDefinitions>

                                <toolkit:Shimmer Grid.Column="0" Width="14" Height="12"
                                                 CornerRadius="3"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowIndexCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <toolkit:Shimmer Grid.Column="1" Width="14" Height="14"
                                                 CornerRadius="7"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowLikeCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Track art shimmer — only paints when ArtColumnWidth > 0.
                                     The Width=34 / Height=34 is intrinsic; the column
                                     either reveals it (42 px column = 4 px margin each
                                     side) or collapses around it. -->
                                <toolkit:Shimmer Grid.Column="2" Width="34" Height="34"
                                                 CornerRadius="4" HorizontalAlignment="Left"
                                                 Visibility="{x:Bind ShowArtCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Title + (optional) artist subtitle.
                                     Margin matches TrackItem RowTitle Margin="12,0,8,0". -->
                                <StackPanel Grid.Column="3" Spacing="6"
                                            VerticalAlignment="Center"
                                            Margin="12,0,8,0">
                                    <toolkit:Shimmer Width="180" Height="14" HorizontalAlignment="Left"/>
                                    <toolkit:Shimmer Width="100" Height="10" HorizontalAlignment="Left"
                                                     Visibility="{x:Bind ShowArtistSubtitle, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>

                                <!-- Album cell skeleton (playlist / liked). 120×12 bar, left-aligned. -->
                                <toolkit:Shimmer Grid.Column="4" Width="120" Height="12"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowAlbumCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- AddedBy cell skeleton (collab playlists). 96×12 bar. -->
                                <toolkit:Shimmer Grid.Column="5" Width="96" Height="12"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowAddedByCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- DateAdded cell skeleton. 80×12 bar, left-aligned. -->
                                <toolkit:Shimmer Grid.Column="6" Width="80" Height="12"
                                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowDateAddedCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- PlayCount cell skeleton (album). 60×12 bar, RIGHT-aligned
                                     to match TrackItem's PlayCount cell (no margin). -->
                                <toolkit:Shimmer Grid.Column="7" Width="60" Height="12"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowPlayCountCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Duration cell skeleton. 36×12, RIGHT-aligned (no margin). -->
                                <toolkit:Shimmer Grid.Column="8" Width="36" Height="12"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Visibility="{x:Bind ShowDurationCell, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>
    </Grid>
</UserControl>
