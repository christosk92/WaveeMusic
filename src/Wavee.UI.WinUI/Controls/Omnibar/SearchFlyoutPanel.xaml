<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Omnibar.SearchFlyoutPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wavee.UI.WinUI.Controls.Omnibar"
    xmlns:contracts="using:Wavee.UI.Contracts"
    xmlns:converters="using:Wavee.UI.WinUI.Converters"
    xmlns:imaging="using:Wavee.UI.WinUI.Controls.Imaging"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>

        <!-- Section header row (flat-list mode). Non-interactive; keyboard nav skips it. -->
        <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="contracts:SearchSuggestionItem">
            <TextBlock Text="{x:Bind Title}"
                       Padding="14,12,12,4"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="80"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{x:Bind local:SearchFlyoutPanel.GetGroupHeaderVisibility(Title)}"/>
        </DataTemplate>

        <!-- Text suggestion (search query) -->
        <DataTemplate x:Key="TextQueryTemplate" x:DataType="contracts:SearchSuggestionItem">
            <Grid Padding="12,9" ColumnSpacing="12" Background="Transparent"
                  Tapped="Item_Tapped"
                  PointerEntered="Item_PointerEntered"
                  PointerExited="Item_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>
                <local:BoldMatchTextBlock Grid.Column="1"
                    Text="{x:Bind Title}" MatchText="{x:Bind QueryText}"
                    VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- Settings deep-link result: gear glyph + title + section breadcrumb. -->
        <DataTemplate x:Key="SettingTemplate" x:DataType="contracts:SearchSuggestionItem">
            <Grid Padding="12,8" ColumnSpacing="12" Background="Transparent"
                  Tapped="Item_Tapped"
                  PointerEntered="Item_PointerEntered"
                  PointerExited="Item_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="13"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Entity (artist, track, album, playlist) - reused for both Spotify and local. -->
        <DataTemplate x:Key="EntityTemplate" x:DataType="contracts:SearchSuggestionItem">
            <Grid Padding="12,6" ColumnSpacing="12" Background="Transparent"
                  Loaded="EntityRoot_Loaded"
                  Tapped="Item_Tapped"
                  PointerEntered="Item_PointerEntered"
                  PointerExited="Item_PointerExited"
                  RightTapped="EntityRoot_RightTapped"
                  Holding="EntityRoot_Holding">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Image (circular for artists, rounded square for others) -->
                <Border Grid.Column="0" Width="40" Height="40"
                        CornerRadius="{x:Bind local:SearchFlyoutPanel.GetImageCornerRadius(Type)}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <imaging:CompositionImage ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                                              DecodePixelSize="40"
                                              Stretch="UniformToFill"/>
                </Border>

                <!-- Title + Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <!-- Action button (Spotify-only; suppressed for local entities + settings via GetActionVisibility) -->
                <Button Grid.Column="2" VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="{x:Bind local:SearchFlyoutPanel.GetActionVisibility(Type)}"
                        ToolTipService.ToolTip="{x:Bind local:SearchFlyoutPanel.GetActionTooltip(Type)}"
                        Click="ActionButton_Click">
                    <FontIcon Glyph="{x:Bind local:SearchFlyoutPanel.GetActionGlyph(Type)}" FontSize="16"/>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Per-section shimmer placeholder: same footprint as EntityTemplate so the
             real entity items swap in without layout shift. -->
        <DataTemplate x:Key="ShimmerTemplate" x:DataType="contracts:SearchSuggestionItem">
            <Grid Padding="12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:Shimmer Grid.Column="0" Width="40" Height="40" CornerRadius="4"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <controls:Shimmer Width="160" Height="13" HorizontalAlignment="Left"/>
                    <controls:Shimmer Width="90" Height="11" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <local:SearchSuggestionTemplateSelector x:Key="SuggestionTemplateSelector"
            TextQueryTemplate="{StaticResource TextQueryTemplate}"
            EntityTemplate="{StaticResource EntityTemplate}"
            SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
            SettingTemplate="{StaticResource SettingTemplate}"
            ShimmerTemplate="{StaticResource ShimmerTemplate}"/>
    </UserControl.Resources>

    <!-- Compact, single-column dropdown. Solid background (no acrylic blur) keeps it
         light to composite; a subtle ThemeShadow gives elevation off the page. -->
    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8"
            MaxHeight="440"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            Translation="0,0,32">
        <Border.Shadow>
            <ThemeShadow/>
        </Border.Shadow>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header (shown for legacy recent-searches flat mode) -->
            <TextBlock x:Uid="Controls_Omnibar_SearchFlyoutPanel__TextBlock_1" x:Name="HeaderText" Grid.Row="0"
                       Text="Recent searches" FontWeight="Bold" FontSize="14"
                       Padding="16,12,16,8" Visibility="Collapsed"/>

            <!-- Single-column shimmer loading state. A header strip + a handful of
                 entity-style skeleton rows; matches the real row footprint so there's
                 no layout shift when results arrive. -->
            <StackPanel x:Name="ShimmerPanel" Grid.Row="1" Padding="0,2,0,8" Visibility="Collapsed">
                <controls:Shimmer Height="11" Width="96" HorizontalAlignment="Left" Margin="14,12,12,6"/>
                <Grid Padding="12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <controls:Shimmer Grid.Column="0" Width="40" Height="40" CornerRadius="4"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <controls:Shimmer Width="170" Height="13" HorizontalAlignment="Left"/>
                        <controls:Shimmer Width="90" Height="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
                <Grid Padding="12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <controls:Shimmer Grid.Column="0" Width="40" Height="40" CornerRadius="20"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <controls:Shimmer Width="130" Height="13" HorizontalAlignment="Left"/>
                        <controls:Shimmer Width="70" Height="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
                <Grid Padding="12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <controls:Shimmer Grid.Column="0" Width="40" Height="40" CornerRadius="4"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <controls:Shimmer Width="190" Height="13" HorizontalAlignment="Left"/>
                        <controls:Shimmer Width="80" Height="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
                <Grid Padding="12,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <controls:Shimmer Grid.Column="0" Width="40" Height="40" CornerRadius="4"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <controls:Shimmer Width="150" Height="13" HorizontalAlignment="Left"/>
                        <controls:Shimmer Width="60" Height="11" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ErrorPanel"
                        Grid.Row="1"
                        Padding="16,14,16,16"
                        Spacing="10"
                        Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE783;"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="ErrorMessageText"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               MaxLines="3"/>
                </StackPanel>
                <Button x:Uid="Controls_Omnibar_SearchFlyoutPanel__Auto_600" x:Name="RetryButton"
                        Content="Retry"
                        HorizontalAlignment="Left"
                        Click="RetryButton_Click"/>
            </StackPanel>

            <!-- Single-column virtualized suggestions list. ItemsRepeater (no ListViewItem
                 container chrome) inside a ScrollViewer; section headers are interleaved
                 rows (SearchSuggestionType.SectionHeader) selected by the template selector. -->
            <ScrollViewer x:Name="ResultsScroller" Grid.Row="1"
                          VerticalScrollMode="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="ResultsList"
                               ItemTemplate="{StaticResource SuggestionTemplateSelector}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="0"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
