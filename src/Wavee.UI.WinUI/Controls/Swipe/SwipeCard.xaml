<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Swipe.SwipeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:imaging="using:Wavee.UI.WinUI.Controls.Imaging"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid x:Name="Root" CornerRadius="18" Background="#222" Width="316" Height="418">
        <!-- Album art (rounded per-layer — WinUI does not clip children to a parent's CornerRadius) -->
        <imaging:CompositionImage x:Name="Art" ImageUrl="{x:Bind ImageUrl, Mode=OneWay}"
                                  DecodePixelSize="600" Stretch="UniformToFill" CornerRadius="18" />

        <!-- bottom scrim -->
        <Border CornerRadius="18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0.34" Color="#00000000" />
                    <GradientStop Offset="0.55" Color="#1F000000" />
                    <GradientStop Offset="1.0" Color="#D1000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- NEW pill (upstream-added track) -->
        <Border x:Name="NewPill" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14"
                CornerRadius="999" Background="#1ED760" Padding="9,4" Visibility="Collapsed">
            <TextBlock Text="NEW" FontSize="11" FontWeight="Bold" Foreground="#062B16" />
        </Border>

        <!-- Keep / Remove stamps -->
        <Border x:Name="LikeStamp" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18"
                CornerRadius="12" BorderBrush="#1ED760" BorderThickness="4" Padding="14,6" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform Angle="13" />
            </Border.RenderTransform>
            <TextBlock Text="KEEP" FontSize="22" FontWeight="Bold" Foreground="#1ED760" />
        </Border>
        <Border x:Name="NopeStamp" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                CornerRadius="12" BorderBrush="#F0455C" BorderThickness="4" Padding="14,6" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform Angle="-13" />
            </Border.RenderTransform>
            <TextBlock Text="REMOVE" FontSize="22" FontWeight="Bold" Foreground="#F0455C" />
        </Border>

        <!-- meta -->
        <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,16" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="22" FontWeight="Bold"
                           Foreground="White" TextTrimming="CharacterEllipsis" />
                <StackPanel x:Name="Eq" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom"
                            Height="16" Visibility="Collapsed">
                    <Rectangle x:Name="EqBar1" Width="3" Height="6" Fill="#1ED760" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="EqBar2" Width="3" Height="14" Fill="#1ED760" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="EqBar3" Width="3" Height="9" Fill="#1ED760" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                    <Rectangle x:Name="EqBar4" Width="3" Height="12" Fill="#1ED760" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{x:Bind ArtistName, Mode=OneWay}" FontSize="14" Foreground="#EAEAEA"
                       TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,12,0,0">
                <ProgressBar x:Name="SnippetBar" Minimum="0" Maximum="1" Height="4"
                             Value="{x:Bind PreviewProgress, Mode=OneWay}"
                             Foreground="#1ED760" Background="#4DFFFFFF" />
                <TextBlock x:Name="NaLabel" Text="Preview unavailable — decide from the details"
                           FontSize="11.5" Foreground="#DCDCDC" Visibility="Collapsed" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
