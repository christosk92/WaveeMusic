<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Wavee.UI.WinUI.Controls.ImageEditor.ImageReframeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">920</x:Double>

        <!-- White rounded nub with a dark hairline — reads on light AND dark images. -->
        <Style x:Key="CornerHandleStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Border Width="16" Height="16" CornerRadius="4" Background="White"
                                    BorderBrush="#80000000" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EdgeHandleHStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Border Width="26" Height="6" CornerRadius="3" Background="White"
                                    BorderBrush="#80000000" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EdgeHandleVStyle" TargetType="primitives:Thumb">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="primitives:Thumb">
                        <Grid Background="Transparent">
                            <Border Width="6" Height="26" CornerRadius="3" Background="White"
                                    BorderBrush="#80000000" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillToggleStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Width="500" Spacing="14">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Subtitle" Grid.Column="0"
                       Text="Drag the photo to move · drag the handles to crop · scroll to zoom. Zoom out for a padded border."
                       FontSize="12.5"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="ResetButton" Grid.Column="1" Content="Reset"
                    Click="ResetButton_Click" VerticalAlignment="Center" />
        </Grid>

        <!-- ── Editor viewport (Win2D scene + crop overlay) ─────────── -->
        <Grid x:Name="Viewport" Width="460" Height="460"
              HorizontalAlignment="Center"
              CornerRadius="8"
              Background="#0A0A0A"
              PointerWheelChanged="Viewport_PointerWheelChanged">
            <Grid.Clip>
                <RectangleGeometry Rect="0,0,460,460" />
            </Grid.Clip>

            <canvas:CanvasControl x:Name="SceneCanvas"
                                  CreateResources="SceneCanvas_CreateResources"
                                  Draw="SceneCanvas_Draw"
                                  IsHitTestVisible="False" />

            <Path Fill="#80000000" IsHitTestVisible="False">
                <Path.Data>
                    <GeometryGroup FillRule="EvenOdd">
                        <RectangleGeometry x:Name="ScrimOuter" Rect="0,0,460,460" />
                        <RectangleGeometry x:Name="ScrimInner" Rect="0,0,460,460" />
                    </GeometryGroup>
                </Path.Data>
            </Path>

            <Border x:Name="CropFrame"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="460" Height="460"
                    BorderBrush="#E6FFFFFF" BorderThickness="1"
                    IsHitTestVisible="False">
                <Grid x:Name="GridLines" Opacity="0">
                    <Grid.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Grid.OpacityTransition>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" HorizontalAlignment="Left" Fill="#59FFFFFF" />
                    <Rectangle Grid.Column="2" Grid.RowSpan="3" Width="1" HorizontalAlignment="Left" Fill="#59FFFFFF" />
                    <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="#59FFFFFF" />
                    <Rectangle Grid.Row="2" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="#59FFFFFF" />
                </Grid>
            </Border>

            <Grid x:Name="PanSurface" Background="Transparent"
                  ManipulationMode="TranslateX,TranslateY"
                  ManipulationStarted="PanSurface_ManipulationStarted"
                  ManipulationDelta="PanSurface_ManipulationDelta"
                  ManipulationCompleted="PanSurface_ManipulationCompleted" />

            <Canvas x:Name="HandleLayer">
                <primitives:Thumb x:Name="HandleNW" Tag="nw" Style="{StaticResource CornerHandleStyle}" />
                <primitives:Thumb x:Name="HandleNE" Tag="ne" Style="{StaticResource CornerHandleStyle}" />
                <primitives:Thumb x:Name="HandleSW" Tag="sw" Style="{StaticResource CornerHandleStyle}" />
                <primitives:Thumb x:Name="HandleSE" Tag="se" Style="{StaticResource CornerHandleStyle}" />
                <primitives:Thumb x:Name="HandleN" Tag="n" Style="{StaticResource EdgeHandleHStyle}" />
                <primitives:Thumb x:Name="HandleS" Tag="s" Style="{StaticResource EdgeHandleHStyle}" />
                <primitives:Thumb x:Name="HandleW" Tag="w" Style="{StaticResource EdgeHandleVStyle}" />
                <primitives:Thumb x:Name="HandleE" Tag="e" Style="{StaticResource EdgeHandleVStyle}" />
            </Canvas>

            <Border x:Name="LoadingOverlay" Background="#CC000000">
                <ProgressRing IsActive="True" Width="36" Height="36" />
            </Border>
        </Grid>

        <!-- ── Controls ──────────────────────────────────────────── -->
        <StackPanel Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Zoom" VerticalAlignment="Center"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Slider x:Name="ZoomSlider" Grid.Column="1"
                        Minimum="0" Maximum="1000" Value="0"
                        VerticalAlignment="Center"
                        ValueChanged="ZoomSlider_ValueChanged" />
                <TextBlock x:Name="ZoomPercentText" Grid.Column="2" Text="100%"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Frame" VerticalAlignment="Center"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="FillToggle" Content="Fill"
                                  Style="{StaticResource PillToggleStyle}" Click="FillToggle_Click" />
                    <ToggleButton x:Name="FitToggle" Content="Fit"
                                  Style="{StaticResource PillToggleStyle}" Click="FitToggle_Click" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Padding" VerticalAlignment="Center"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ToggleButton x:Name="BlurToggle" Content="Blur"
                                  Style="{StaticResource PillToggleStyle}" IsChecked="True" Click="BlurToggle_Click" />
                    <ToggleButton x:Name="SolidToggle" Content="Solid"
                                  Style="{StaticResource PillToggleStyle}" Click="SolidToggle_Click" />
                    <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Opacity="0.55">
                        <Border x:Name="Swatch0" Width="24" Height="24" CornerRadius="12" Background="#000000"
                                Tag="#FF000000" BorderBrush="#99808080" BorderThickness="2" Tapped="Swatch_Tapped"
                                ToolTipService.ToolTip="Black" />
                        <Border x:Name="Swatch1" Width="24" Height="24" CornerRadius="12" Background="#FFFFFF"
                                Tag="#FFFFFFFF" BorderBrush="#99808080" BorderThickness="2" Tapped="Swatch_Tapped"
                                ToolTipService.ToolTip="White" />
                        <Border x:Name="Swatch2" Width="24" Height="24" CornerRadius="12" Background="#121212"
                                Tag="#FF121212" BorderBrush="#99808080" BorderThickness="2" Tapped="Swatch_Tapped"
                                ToolTipService.ToolTip="Near-black" />
                        <Border x:Name="Swatch3" Width="24" Height="24" CornerRadius="12" Background="#535353"
                                Tag="#FF535353" BorderBrush="#99808080" BorderThickness="2" Tapped="Swatch_Tapped"
                                ToolTipService.ToolTip="Grey" />
                        <!-- Custom color: opens a ColorPicker flyout; picking switches the fill to Solid. -->
                        <Border x:Name="SwatchCustom" Width="24" Height="24" CornerRadius="12"
                                BorderBrush="#99808080" BorderThickness="2" Tapped="SwatchCustom_Tapped"
                                ToolTipService.ToolTip="Custom color…">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFE53935" Offset="0.0" />
                                    <GradientStop Color="#FFFFEB3B" Offset="0.35" />
                                    <GradientStop Color="#FF43A047" Offset="0.65" />
                                    <GradientStop Color="#FF1E88E5" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <primitives:FlyoutBase.AttachedFlyout>
                                <Flyout>
                                    <ColorPicker x:Name="CustomColorPicker"
                                                 IsAlphaEnabled="False"
                                                 IsColorSliderVisible="True"
                                                 IsColorChannelTextInputVisible="False"
                                                 IsHexInputVisible="True"
                                                 IsMoreButtonVisible="False"
                                                 ColorChanged="CustomColorPicker_ColorChanged" />
                                </Flyout>
                            </primitives:FlyoutBase.AttachedFlyout>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>
</ContentDialog>
