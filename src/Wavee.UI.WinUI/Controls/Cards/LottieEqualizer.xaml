<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Cards.LottieEqualizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="False">

    <!-- Composition-driven equalizer bars (see code-behind). Designed in a fixed
         ~18x16 space and uniformly scaled to IconSize by the Viewbox; each bar's
         height is animated by a looping Composition Scale.Y animation on the
         compositor thread (replaces the old Lottie vector that dominated idle CPU). -->
    <Viewbox x:Name="BarsViewbox" Stretch="Uniform">
        <StackPanel Orientation="Horizontal" Spacing="2" Height="16">
            <Rectangle x:Name="Bar0" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"/>
            <Rectangle x:Name="Bar1" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"/>
            <Rectangle x:Name="Bar2" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Bottom"/>
        </StackPanel>
    </Viewbox>
</UserControl>
