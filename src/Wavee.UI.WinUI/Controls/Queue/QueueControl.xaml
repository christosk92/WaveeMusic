<UserControl
    x:Class="Wavee.UI.WinUI.Controls.Queue.QueueControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:Wavee.UI.WinUI.Controls.Queue"
    xmlns:cards="using:Wavee.UI.WinUI.Controls.Cards"
    xmlns:converters="using:Wavee.UI.WinUI.Converters"
    xmlns:shimmer="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SpotifyImageConverter x:Key="SpotifyImageConverter"/>

        <!-- Queue rows are ListViewItems; strip the default padding / min-height
             so they match the 52px row template, and keep content stretched. -->
        <Style x:Key="QueueRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <!-- Shared track row template. Title → album, artist → artist (click-
             through links); duration before the grip; the whole row drags to
             reorder, the grip is the visible cue. -->
        <DataTemplate x:Key="TrackTemplate" x:DataType="local:QueueDisplayItem">
            <Grid x:Name="TrackRoot"
                  Padding="6,6"
                  ColumnSpacing="12"
                  Height="52"
                  CornerRadius="4"
                  Background="Transparent"
                  Loaded="TrackRoot_Loaded"
                  PointerEntered="TrackRow_PointerEntered"
                  PointerExited="TrackRow_PointerExited"
                  Opacity="{x:Bind VisualOpacity, Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Border CornerRadius="4"
                                Background="{x:Bind ArtworkTintBrush, Mode=OneWay}"
                                Visibility="{x:Bind ArtworkTintVisibility, Mode=OneWay}"/>
                        <!-- Music-note placeholder sits behind the image; the image covers
                             it once it loads. When ImageUrl is null (queue track wasn't
                             enriched), this is what the user sees instead of an empty tile. -->
                        <FontIcon Glyph="&#xE8D6;"
                                  FontSize="18"
                                  Opacity="0.4"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind IsLoaded, Mode=OneTime}"/>
                        <Image Stretch="UniformToFill"
                               Visibility="{x:Bind IsLoaded, Mode=OneTime}"
                               Source="{x:Bind ImageUrl, Mode=OneTime, Converter={StaticResource SpotifyImageConverter}, ConverterParameter=40}"/>
                    </Grid>
                </Border>
                <shimmer:Shimmer Grid.Column="0" Width="40" Height="40"
                                 Visibility="{x:Bind IsShimmer, Mode=OneTime}"/>

                <!-- Hover play button over the artwork — skips playback to this
                     queue item. Shown by TrackRow_PointerEntered. -->
                <Button x:Name="RowPlayButton"
                        Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="4"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="0"
                        IsHitTestVisible="False"
                        Tag="{x:Bind Mode=OneTime}"
                        Click="RowPlay_Click"
                        ToolTipService.ToolTip="Play"
                        Visibility="{x:Bind IsLoaded, Mode=OneTime}">
                    <Grid>
                        <Border CornerRadius="4" Background="#A6000000"/>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Glyph="&#xE768;"
                                  FontSize="16"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1"
                            Visibility="{x:Bind IsLoaded, Mode=OneTime}">
                    <HyperlinkButton Tag="{x:Bind Mode=OneTime}"
                                     Click="TitleLink_Click"
                                     Padding="0" MinWidth="0" MinHeight="0"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Left"
                                     ToolTipService.ToolTip="{x:Bind Title, Mode=OneTime}">
                        <TextBlock Text="{x:Bind Title, Mode=OneTime}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                    </HyperlinkButton>
                    <HyperlinkButton Tag="{x:Bind Mode=OneTime}"
                                     Click="ArtistLink_Click"
                                     Padding="0" MinWidth="0" MinHeight="0"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Left">
                        <TextBlock Text="{x:Bind Subtitle, Mode=OneTime}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"/>
                    </HyperlinkButton>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                            Visibility="{x:Bind IsShimmer, Mode=OneTime}">
                    <shimmer:Shimmer Width="160" Height="12" HorizontalAlignment="Left"/>
                    <shimmer:Shimmer Width="110" Height="10" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Track duration -->
                <TextBlock x:Name="RowDurationText"
                           Grid.Column="2"
                           Text="{x:Bind Duration, Mode=OneTime}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"
                           Visibility="{x:Bind IsLoaded, Mode=OneTime}"/>

                <!-- Same hover affordance as TrackItem: swap the duration for
                     a trailing More button so queue rows have a direct pointer
                     path to the shared track context menu. -->
                <Button x:Name="RowMoreButton"
                        Grid.Column="2"
                        Width="28" Height="28"
                        Padding="0"
                        CornerRadius="14"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Tag="{x:Bind Mode=OneTime}"
                        Click="RowMore_Click"
                        AutomationProperties.Name="More options"
                        ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="14"/>
                </Button>

                <!-- Hamburger grip — the reorder-drag cue. Hand cursor set in code-behind. -->
                <FontIcon x:Name="DragHandle"
                          Grid.Column="3"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE700;"
                          FontSize="14"
                          Margin="4,0,4,0"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          VerticalAlignment="Center"
                          Loaded="DragHandle_Loaded"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Pinned queue controls. Active state keeps the checked background. -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="6"
                    Margin="0,10,0,12">
            <ToggleButton x:Name="ShuffleButton"
                          Width="42" Height="34"
                          MinWidth="42" MinHeight="34"
                          Padding="0"
                          CornerRadius="17"
                          ToolTipService.ToolTip="Shuffle"
                          Click="ShuffleButton_Click">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE8B1;" FontSize="14"/>
            </ToggleButton>

            <ToggleButton x:Name="RepeatButton"
                          Width="42" Height="34"
                          MinWidth="42" MinHeight="34"
                          Padding="0"
                          CornerRadius="17"
                          ToolTipService.ToolTip="Repeat"
                          Click="RepeatButton_Click">
                <FontIcon x:Name="RepeatGlyph"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE8EE;" FontSize="14"/>
            </ToggleButton>

            <ToggleButton x:Name="InfiniteButton"
                          Width="42" Height="34"
                          MinWidth="42" MinHeight="34"
                          Padding="0"
                          CornerRadius="17"
                          ToolTipService.ToolTip="Autoplay"
                          Click="InfiniteButton_Click">
                <TextBlock Text="&#x221E;"
                           FontSize="18"
                           FontWeight="SemiBold"
                           LineHeight="18"
                           VerticalAlignment="Center"
                           Margin="0,-3,0,0"/>
            </ToggleButton>

            <ToggleButton x:Name="CrossfadeButton"
                          Width="42" Height="34"
                          MinWidth="42" MinHeight="34"
                          Padding="0"
                          CornerRadius="17"
                          ToolTipService.ToolTip="Crossfade"
                          Click="CrossfadeButton_Click">
                <TextBlock Text="&#x21CC;"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </ToggleButton>
        </StackPanel>

        <!-- Scrolling content -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel Spacing="0" Padding="0,0,0,160">

                <!-- Playing-from breadcrumb. Borderless / fill-less single line; the
                     visual contrast against the bordered NowPlayingCard below is what
                     differentiates "what we're playing from" from "what's playing now". -->
                <Button x:Name="ContextCard"
                        Visibility="Collapsed"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Margin="0,0,0,8"
                        Padding="6,6"
                        CornerRadius="2"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Open playback context"
                        Click="ContextCard_Click">
                    <Grid ColumnSpacing="10" MinHeight="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="3"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image x:Name="ContextArt" Stretch="UniformToFill"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="Playing from "
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Run x:Name="ContextTitle"
                                 FontWeight="SemiBold"/>
                        </TextBlock>

                        <FontIcon Grid.Column="2"
                                  Glyph="&#xE8A7;"
                                  FontSize="12"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="2,0,2,0"/>
                    </Grid>
                </Button>

                <!-- Now Playing card -->
                <Border x:Name="NowPlayingCard"
                        Visibility="Collapsed"
                        CornerRadius="4"
                        Margin="0,0,0,12"
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="12" MinHeight="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                            <Image x:Name="NowPlayingArt" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="NowPlayingTitle"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="14"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="NowPlayingArtist"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <cards:LottieEqualizer Grid.Column="2"
                                               x:Name="NowPlayingEqualizer"
                                               IsActive="True"
                                               IconSize="16"
                                               VerticalAlignment="Center"
                                               Margin="4,0,4,0"/>
                    </Grid>
                </Border>

                <!-- User queue section -->
                <StackPanel x:Name="UserQueueSection" Visibility="Collapsed" Spacing="0">
                    <Grid Margin="2,8,2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UserQueueHeaderLabel"
                                   Text="Queue"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <HyperlinkButton Grid.Column="1"
                                         x:Name="ClearQueueButton"
                                         Content="Clear"
                                         FontSize="12"
                                         Padding="6,2"
                                         Click="ClearQueueButton_Click"/>
                    </Grid>
                    <ListView x:Name="UserQueueRepeater"
                              ItemTemplate="{StaticResource TrackTemplate}"
                              ItemContainerStyle="{StaticResource QueueRowContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              AllowDrop="True"
                              DragOver="Section_DragOver"
                              Drop="Section_Drop"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>

                <!-- Next up section -->
                <StackPanel x:Name="NextUpSection" Visibility="Collapsed" Spacing="0">
                    <TextBlock x:Name="NextUpHeader"
                               Text="Next up"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="2,14,2,4"/>
                    <ListView x:Name="NextUpRepeater"
                              ItemTemplate="{StaticResource TrackTemplate}"
                              ItemContainerStyle="{StaticResource QueueRowContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              AllowDrop="True"
                              DragOver="Section_DragOver"
                              Drop="Section_Drop"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>

                <!-- Queued later (post-context bucket — "Add to Queue" items
                     that play after the context exhausts, before autoplay) -->
                <StackPanel x:Name="PostContextSection" Visibility="Collapsed" Spacing="0">
                    <StackPanel Margin="2,14,2,4" Spacing="1">
                        <TextBlock x:Name="PostContextHeader"
                                   Text="Queued later"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Plays after this context finishes"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ListView x:Name="PostContextRepeater"
                              ItemTemplate="{StaticResource TrackTemplate}"
                              ItemContainerStyle="{StaticResource QueueRowContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              AllowDrop="True"
                              DragOver="Section_DragOver"
                              Drop="Section_Drop"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>

                <!-- Autoplay section (progressively dimmed) -->
                <StackPanel x:Name="AutoPlaySection" Visibility="Collapsed" Spacing="0">
                    <StackPanel x:Name="AutoPlayHeader" Margin="2,14,2,4" Spacing="1">
                        <TextBlock Text="Autoplay"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="Similar music will keep playing"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <ListView x:Name="AutoPlayRepeater"
                              ItemTemplate="{StaticResource TrackTemplate}"
                              ItemContainerStyle="{StaticResource QueueRowContainerStyle}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              AllowDrop="True"
                              DragOver="Section_DragOver"
                              Drop="Section_Drop"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>

                <!-- Delimiter -->
                <StackPanel x:Name="DelimiterSection" Visibility="Collapsed"
                            HorizontalAlignment="Center" Spacing="4" Margin="0,16,0,4">
                    <FontIcon Glyph="&#xE71A;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DelimiterText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>

            <!-- Drag-reorder insertion line overlay. Hit-test-invisible so drag
                 events still reach the section ListViews underneath. -->
            <Canvas x:Name="DropIndicatorOverlay" IsHitTestVisible="False"/>
          </Grid>
        </ScrollView>

        <!-- Empty state -->
        <TextBlock x:Uid="Controls_Queue_QueueControl__TextBlock_2" x:Name="EmptyState"
                   Text="Your queue is empty. Play something to see it here."
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="WrapWholeWords"
                   FontSize="13"
                   Visibility="Collapsed"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Grid.RowSpan="2"
                   Margin="16"/>
    </Grid>
</UserControl>
