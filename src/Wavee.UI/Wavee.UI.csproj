<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Wavee.Controls.Lyrics which is Windows-TFM. No UseWinUI, no MSIX packaging — this stays a plain class library consumable from any test project. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Wavee.UI</RootNamespace>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>

    <!-- Native AOT Compatibility (mirror Wavee core). Wavee.UI.WinUI publishes
         with PublishAot=true for Release; every project it references has to
         carry these analyzer flags so reflection / dynamic-code lapses surface
         at build time on the closest project, not at the top-level publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!-- Treat AOT/Trim warnings as errors -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2050;IL2055;IL2060;IL2067;IL2069;IL2070;IL2072;IL2073;IL2075;IL2076;IL2077;IL2079;IL2080;IL2081;IL2082;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
    <!-- IMessenger is used by services that move down from Wavee.UI.WinUI in
         Phase 3 (mutation services that emit cross-VM notifications). -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wavee\Wavee.csproj" />
    <ProjectReference Include="..\Wavee.Local\Wavee.Local.csproj" />
    <ProjectReference Include="..\Wavee.Controls.Lyrics\Wavee.Controls.Lyrics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Wavee.UI.Tests" />
    <InternalsVisibleTo Include="Wavee.UI.WinUI" />
  </ItemGroup>

</Project>
