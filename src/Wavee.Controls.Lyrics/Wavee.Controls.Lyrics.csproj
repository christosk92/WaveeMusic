<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>$(WaveeWindowsTfm)</TargetFramework>
		<!-- Aligned with Wavee.UI.WinUI's Windows 11 24H2 floor — see notes there. -->
		<TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
		<RootNamespace>Wavee.Controls.Lyrics</RootNamespace>
		<Platforms>x86;x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>

		<!-- Native AOT Compatibility (mirror Wavee core). -->
		<IsAotCompatible>true</IsAotCompatible>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
		<EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2050;IL2055;IL2060;IL2067;IL2069;IL2070;IL2072;IL2073;IL2075;IL2076;IL2077;IL2079;IL2080;IL2081;IL2082;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL2092;IL2093;IL2094;IL2095;IL2096;IL2097;IL2098;IL2099;IL2100;IL2101;IL2102;IL2103;IL2104;IL2105;IL2106;IL2107;IL2108;IL2109;IL2110;IL2111;IL2112;IL2113;IL2114;IL2115;IL2116;IL3050;IL3051;IL3052;IL3053;IL3054;IL3055;IL3056</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.WinUI.Converters" Version="8.3.260402-preview2" />
		<PackageReference Include="CommunityToolkit.WinUI.Helpers" Version="8.3.260402-preview2" />
		<PackageReference Include="ComputeSharp.D2D1.WinUI" Version="3.2.0" />
		<PackageReference Include="csharp-pinyin" Version="1.0.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(WaveeDotNetPackageVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="$(WaveeDotNetPackageVersion)" />
		<PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.4-experimental8" />
		<PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
		<PackageReference Include="NTextCat" Version="0.3.65" />
		<PackageReference Include="SpoutDx.Net.Interop.MultiPlatform" Version="0.1.0" />
		<PackageReference Include="Vanara.PInvoke.User32" Version="5.0.5" />
		<PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
		<PackageReference Include="WanaKana-net" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\vendor\Lyricify.Lyrics.Helper\Lyricify.Lyrics.Helper.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\AlbumArtPlaceholder.png">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Assets\Core14.profile.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="ColorThief\" />
	  <Folder Include="NewFolder\" />
	</ItemGroup>

	<Target Name="EnsureIntermediateControlXaml" BeforeTargets="CopyFilesToOutputDirectory">
		<MakeDir Directories="$(IntermediateOutputPath)Controls" />
		<Copy SourceFiles="Controls\ImageSwitcher.xaml" DestinationFiles="$(IntermediateOutputPath)Controls\ImageSwitcher.xaml" SkipUnchangedFiles="true" />
		<Copy SourceFiles="Controls\NowPlayingCanvas.xaml" DestinationFiles="$(IntermediateOutputPath)Controls\NowPlayingCanvas.xaml" SkipUnchangedFiles="true" />
		<Copy SourceFiles="Controls\ShadowImage.xaml" DestinationFiles="$(IntermediateOutputPath)Controls\ShadowImage.xaml" SkipUnchangedFiles="true" />
	</Target>
</Project>
