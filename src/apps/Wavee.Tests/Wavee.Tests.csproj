<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the 0.3 CORE through a project reference to Wavee.csproj (D3/D17) — they construct any core type but
       never start the engine loop. The old 0.2.9 suite is parked in src/apps/_old/Wavee.Tests (not compiled) and is
       ported per wave (plan §6). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- xUnit1051: the v3 "pass TestContext.Current.CancellationToken" nag is noise for these deterministic,
         non-cancellable unit tests. TreatWarningsAsErrors stays inherited (true) — this is new code. -->
    <NoWarn>$(NoWarn);xUnit1051;CA1416</NoWarn>   <!-- CA1416: the tests run on Windows only; the OS bridge facts name WinRT enums -->
    <DefineConstants>$(DefineConstants);WAVEE_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured wire answers the decoder tests read (Wave 2): the bundled pathfinder exports. Protobuf fixtures are
         BUILT in the tests from the generated `Wavee.Protocol` messages instead of checked in, so a decoder is pinned
         against the canonical encoder rather than against a blob nobody can regenerate. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wavee\Wavee.csproj" />
    <!-- the P/Invoke shims some tests use -->
    <ProjectReference Include="$(EngineRoot)src\FluentGpu.WindowsApi\FluentGpu.WindowsApi.csproj" />
  </ItemGroup>

</Project>
