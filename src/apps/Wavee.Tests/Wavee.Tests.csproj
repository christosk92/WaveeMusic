<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests the 0.3 CORE through a project reference to Wavee.csproj (D3/D17) — they construct any core type but
       never start the engine loop. The old 0.2.9 suite is parked in src/apps/_old/Wavee.Tests (not compiled) and is
       ported per wave (plan §6). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- xUnit1051: the v3 "pass TestContext.Current.CancellationToken" nag is noise for these deterministic,
         non-cancellable unit tests. TreatWarningsAsErrors stays inherited (true) — this is new code. -->
    <NoWarn>$(NoWarn);xUnit1051;CA1416</NoWarn>   <!-- CA1416: the tests run on Windows only; the OS bridge facts name WinRT enums -->
    <DefineConstants>$(DefineConstants);WAVEE_TESTS</DefineConstants>
    <!-- Non-concurrent (blocking) gen2 GC — a MEASUREMENT fix for the zero-allocation facts that assert
         GC.GetAllocatedBytesForCurrentThread() deltas == 0 (the app keeps background GC on via Directory.Build.props).
         With background GC on, the counter over-reports up to ~8 KB when a background gen2 GC suspends the runtime
         inside the measured window, so an allocation-free loop can read non-zero under load. Same override as the
         engine's VerticalSlice harness and test projects. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured wire answers the decoder tests read (Wave 2): the bundled pathfinder exports. Protobuf fixtures are
         BUILT in the tests from the generated `Wavee.Protocol` messages instead of checked in, so a decoder is pinned
         against the canonical encoder rather than against a blob nobody can regenerate. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The app ↔ Worker multipart contract (#165): the SAME bytes the Worker's vitest suite parses. CrashContractTests
         packs fixed bundles and compares byte for byte; a mismatch writes crash-contract-actual\<name>.multipart. -->
    <None Include="..\..\..\ops\crash\contract\*.multipart" Link="Fixtures\crash-contract\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wavee\Wavee.csproj" />
    <ProjectReference Include="..\..\..\ops\loc\Wavee.LocPack\Wavee.LocPack.csproj" />
    <!-- the P/Invoke shims some tests use -->
    <ProjectReference Include="$(EngineRoot)src\FluentGpu.WindowsApi\FluentGpu.WindowsApi.csproj" />
  </ItemGroup>

  <!-- The private local-playback package's facts (decision D3): linked only when the junction carries the 0.3 package,
       the same gate Wavee.csproj compiles the package behind. -->
  <ItemGroup Condition="'$(WaveeSkipPrivateSources)' != 'true' And Exists('..\Wavee.PlayPlay\Client\PlayPlayHost.cs')">
    <Compile Include="..\Wavee.PlayPlay\Tests\**\*.cs" Link="Wavee.PlayPlay\Tests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
