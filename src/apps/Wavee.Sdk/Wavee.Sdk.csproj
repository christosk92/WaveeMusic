<Project Sdk="Microsoft.NET.Sdk">

  <!-- The public playback-module SDK: the wire protocol (JSON-RPC 2.0 over stdio, LSP framing + binary frames), the
       module author surface (WaveeModule / ModuleRunner / ModuleTestHost) and the reusable byte-stream building blocks
       (Wavee.Sdk.Streams). ZERO project references by design — this is the NuGet a third-party module references.
       AOT-clean: every JSON shape goes through the SdkJsonContext source generator. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Wavee.Sdk</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageId>Wavee.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>SDK for Wavee playback modules.</Description>
  </PropertyGroup>

</Project>
